# Single source of truth for the vLLM serving images this lab runs.
#
# Every manifest, serving-profile CSV, and helper resolves its image from one of
# these names. ./scripts/experiment validate fails if any of them drift, so a
# version can never be changed in one place and silently left behind in another.
#
# Serving-profile CSVs reference these symbolically, for example:
#   modern-vllm-0221,,,@VLLM_IMAGE_MODERN@,9216,...
#
# Changing a value here changes the engine that future runs measure. Evidence
# already curated under a previous engine keeps its recorded image and is not
# rewritten: see experiments/kv-cache-observatory/experiment.yaml.

# Legacy baseline. Ties the curated evidence in experiments/*/evidence/, which
# was measured on this engine. Also the image in platform/inference/vllm-openai.yaml.
VLLM_IMAGE_DEFAULT="vllm/vllm-openai:v0.9.0"

# Current target for new KV-cache observatory work.
VLLM_IMAGE_MODERN="vllm/vllm-openai:v0.22.1"

# Blackwell / NVFP4 quantization path.
VLLM_IMAGE_BLACKWELL="vllm/vllm-openai:v0.20.1"
