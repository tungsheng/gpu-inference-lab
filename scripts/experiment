default_report_prefix() {
  local experiment_name=$1
  local case_id=$2
  local profile_id=$3
  local timestamp=$4

  printf '%s/experiment-%s-%s-%s-%s' "${REPORTS_DIR}" "${experiment_name}" "${case_id}" "${profile_id}" "${timestamp}"
}

resolve_report_paths_for_case() {
  local experiment_name=$1
  local case_id=$2
  local profile_id=$3
  local timestamp=$4
  local report_path=$5
  local json_report_path=$6
  local report_prefix

  if [[ -z "${report_path}" || -z "${json_report_path}" ]]; then
    report_prefix=$(default_report_prefix "${experiment_name}" "${case_id}" "${profile_id}" "${timestamp}")
    if [[ -z "${report_path}" ]]; then
      report_path="${report_prefix}.md"
    fi
    if [[ -z "${json_report_path}" ]]; then
      json_report_path="${report_prefix}.json"
    fi
  fi

  printf '%s\n%s\n' "${report_path}" "${json_report_path}"
}

write_report_files() {
  local experiment_name=$1
  local case_id=$2
  local profile_id=$3
  local report_path=$4
  local json_report_path=$5
  local generated_at=$6

  mkdir -p "$(dirname "${report_path}")"
  mkdir -p "$(dirname "${json_report_path}")"

  require_experiment "${experiment_name}"
  load_case "${experiment_name}" "${case_id}"
  load_serving_profile "${experiment_name}" "${profile_id}"
  validate_case_profile_compatibility "${experiment_name}"

  render_report_markdown "${experiment_name}" "${case_id}" "${profile_id}" "${generated_at}" > "${report_path}"
  render_report_json "${experiment_name}" "${case_id}" "${profile_id}" "${generated_at}" > "${json_report_path}"
}

extract_experiment_prometheus_scalar() {
  tr -d '\n' | sed -n 's/.*"value":\[[^,]*,"\([^"]*\)"\].*/\1/p'
}

stop_experiment_prometheus_port_forward() {
  if [[ -n "${EXPERIMENT_PROMETHEUS_PORT_FORWARD_PID}" ]]; then
    kill "${EXPERIMENT_PROMETHEUS_PORT_FORWARD_PID}" 2>/dev/null || true
    wait "${EXPERIMENT_PROMETHEUS_PORT_FORWARD_PID}" 2>/dev/null || true
  fi

  if [[ -n "${EXPERIMENT_PROMETHEUS_PORT_FORWARD_LOG}" ]]; then
    rm -f "${EXPERIMENT_PROMETHEUS_PORT_FORWARD_LOG}" 2>/dev/null || true
  fi

  EXPERIMENT_PROMETHEUS_LOCAL_PORT=""
  EXPERIMENT_PROMETHEUS_PORT_FORWARD_PID=""
  EXPERIMENT_PROMETHEUS_PORT_FORWARD_LOG=""
}

start_experiment_prometheus_port_forward() {
  local remaining_attempts=30
  local local_port=""

  if [[ -n "${EXPERIMENT_PROMETHEUS_LOCAL_PORT}" ]]; then
    if [[ -n "${EXPERIMENT_PROMETHEUS_PORT_FORWARD_PID}" ]] &&
      kill -0 "${EXPERIMENT_PROMETHEUS_PORT_FORWARD_PID}" 2>/dev/null; then
      return 0
    fi

    stop_experiment_prometheus_port_forward
  fi

  EXPERIMENT_PROMETHEUS_PORT_FORWARD_LOG=$(mktemp "${TMPDIR:-/tmp}/gpu-lab-experiment-prometheus.XXXXXX")
  kubectl port-forward \
    -n "${MONITORING_NAMESPACE}" \
    "service/${KUBE_PROMETHEUS_STACK_PROMETHEUS_SERVICE}" \
    ":9090" >"${EXPERIMENT_PROMETHEUS_PORT_FORWARD_LOG}" 2>&1 &
  EXPERIMENT_PROMETHEUS_PORT_FORWARD_PID=$!

  while (( remaining_attempts > 0 )); do
    if ! kill -0 "${EXPERIMENT_PROMETHEUS_PORT_FORWARD_PID}" 2>/dev/null; then
      stop_experiment_prometheus_port_forward
      return 1
    fi

    local_port=$(sed -n 's/.*127\.0\.0\.1:\([0-9][0-9]*\).*/\1/p' "${EXPERIMENT_PROMETHEUS_PORT_FORWARD_LOG}" | head -n 1)
    if [[ -n "${local_port}" ]]; then
      EXPERIMENT_PROMETHEUS_LOCAL_PORT=${local_port}
      return 0
    fi

    remaining_attempts=$((remaining_attempts - 1))
    sleep 0.1
  done

  stop_experiment_prometheus_port_forward
  return 1
}

experiment_prometheus_query_scalar() {
  local query=$1
  local query_time=${2:-}
  local response
  local scalar_value
  local curl_args

  start_experiment_prometheus_port_forward || return 1

  curl_args=(
    -fsS
    --get
    "http://127.0.0.1:${EXPERIMENT_PROMETHEUS_LOCAL_PORT}/api/v1/query"
    --data-urlencode
    "query=${query}"
  )
  if [[ -n "${query_time}" ]]; then
    curl_args+=(--data-urlencode "time=${query_time}")
  fi

  response=$(curl "${curl_args[@]}" 2>/dev/null || true)
  if [[ -z "${response}" ]]; then
    printf '%s\n' ""
    return 0
  fi

  scalar_value=$(printf '%s' "${response}" | extract_experiment_prometheus_scalar)
  if [[ "${scalar_value}" == "NaN" || "${scalar_value}" == "+Inf" || "${scalar_value}" == "-Inf" ]]; then
    printf '%s\n' ""
    return 0
  fi

  printf '%s\n' "${scalar_value}"
}

experiment_scalar_is_positive() {
  local value=${1:-}

  [[ -n "${value}" ]] || return 1
  awk -v value="${value}" 'BEGIN { exit !((value + 0) > 0) }'
}

collect_experiment_histogram_quantile_metric() {
  local destination_var=$1
  local quantile=$2
  local window=$3
  local query_time=$4
  local metric_name
  local query
  local value

  shift 4
  printf -v "${destination_var}" '%s' ""

  for metric_name in "$@"; do
    query="histogram_quantile(${quantile}, sum by (le) (increase(${metric_name}{namespace=\"${APP_NAMESPACE}\"}[${window}])))"
    value=$(experiment_prometheus_query_scalar "${query}" "${query_time}") || return 1
    if [[ -n "${value}" ]]; then
      printf -v "${destination_var}" '%s' "${value}"
      return 0
    fi
  done
}

collect_experiment_first_scalar_query() {
  local destination_var=$1
  local query_time=$2
  local query
  local value

  shift 2
  printf -v "${destination_var}" '%s' ""

  for query in "$@"; do
    value=$(experiment_prometheus_query_scalar "${query}" "${query_time}") || return 1
    if [[ -n "${value}" ]]; then
      printf -v "${destination_var}" '%s' "${value}"
      return 0
    fi
  done
}

print_experiment_dcgm_diagnostics() {
  printf 'DCGM diagnostics:\n' >&2
  kubectl get daemonset "${DCGM_EXPORTER_DAEMONSET_NAME}" -n "${MONITORING_NAMESPACE}" -o wide >&2 || true
  kubectl get pods -n "${MONITORING_NAMESPACE}" -l app.kubernetes.io/name=dcgm-exporter -o wide >&2 || true
  kubectl get endpointslice \
    -n "${MONITORING_NAMESPACE}" \
    -l "kubernetes.io/service-name=${DCGM_EXPORTER_SERVICE_NAME}" \
    -o yaml >&2 || true
  kubectl get nodes -l workload=gpu -o wide >&2 || true
}

wait_for_experiment_dcgm_metrics() {
  local timeout_seconds=${EXPERIMENT_DCGM_METRICS_TIMEOUT_SECONDS}
  local start_time
  local elapsed_seconds
  local endpoint_addresses=""
  local gpu_util_count=""
  local fb_used_count=""
  local fb_free_count=""

  require_non_negative_integer "${timeout_seconds}" "experiment DCGM metrics timeout seconds"

  if ! command -v curl >/dev/null 2>&1; then
    printf 'curl is required to verify DCGM metrics before running the experiment.\n' >&2
    return 1
  fi

  printf 'Waiting for DCGM GPU metrics in Prometheus (timeout: %ss)\n' "${timeout_seconds}"
  start_time=$(date +%s)

  while true; do
    endpoint_addresses=$(kubectl get endpointslice \
      -n "${MONITORING_NAMESPACE}" \
      -l "kubernetes.io/service-name=${DCGM_EXPORTER_SERVICE_NAME}" \
      -o 'jsonpath={.items[*].endpoints[*].addresses[*]}' 2>/dev/null || true)

    if [[ -n "${endpoint_addresses}" ]]; then
      gpu_util_count=$(experiment_prometheus_query_scalar "count(DCGM_FI_DEV_GPU_UTIL)") || return 1
      fb_used_count=$(experiment_prometheus_query_scalar "count(DCGM_FI_DEV_FB_USED)") || return 1
      fb_free_count=$(experiment_prometheus_query_scalar "count(DCGM_FI_DEV_FB_FREE)") || return 1

      if experiment_scalar_is_positive "${gpu_util_count}" &&
        experiment_scalar_is_positive "${fb_used_count}" &&
        experiment_scalar_is_positive "${fb_free_count}"; then
        return 0
      fi
    fi

    elapsed_seconds=$(($(date +%s) - start_time))
    if (( elapsed_seconds >= timeout_seconds )); then
      printf 'Timed out waiting for DCGM GPU metrics in Prometheus: endpoints=%s gpu_util_count=%s fb_used_count=%s fb_free_count=%s\n' \
        "$(display_optional_metric "${endpoint_addresses}")" \
        "$(display_optional_metric "${gpu_util_count}")" \
        "$(display_optional_metric "${fb_used_count}")" \
        "$(display_optional_metric "${fb_free_count}")" >&2
      print_experiment_dcgm_diagnostics
      stop_experiment_prometheus_port_forward
      return 1
    fi

    sleep "${POLL_INTERVAL_SECONDS}"
  done
}

experiment_metric_lookback_window() {
  local duration_seconds=${RESULT_RUN_DURATION_SECONDS:-}

  if [[ -n "${EXPERIMENT_LOAD_START_EPOCH_SECONDS:-}" && -n "${EXPERIMENT_LOAD_END_EPOCH_SECONDS:-}" ]] &&
    (( EXPERIMENT_LOAD_END_EPOCH_SECONDS > EXPERIMENT_LOAD_START_EPOCH_SECONDS )); then
    duration_seconds=$((EXPERIMENT_LOAD_END_EPOCH_SECONDS - EXPERIMENT_LOAD_START_EPOCH_SECONDS))
  elif [[ -z "${duration_seconds}" ]]; then
    duration_seconds=$(case_planned_duration_seconds)
  fi

  awk -v duration="${duration_seconds}" 'BEGIN {
    window = int(duration)
    if (window < 60) {
      window = 60
    }
    printf "%ss\n", window
  }'
}

collect_experiment_observability_metrics() {
  local window
  local query_time=""
  local kv_cache_query_tokens=""

  command -v curl >/dev/null 2>&1 || return 0
  start_experiment_prometheus_port_forward || return 0

  window=$(experiment_metric_lookback_window)
  if [[ -n "${EXPERIMENT_LOAD_END_EPOCH_SECONDS:-}" ]]; then
    query_time=${EXPERIMENT_LOAD_END_EPOCH_SECONDS}
  fi

  RESULT_PEAK_WAITING_REQUESTS=$(experiment_prometheus_query_scalar "max_over_time((sum(vllm:num_requests_waiting{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" "${query_time}")
  RESULT_PEAK_RUNNING_REQUESTS=$(experiment_prometheus_query_scalar "max_over_time((sum(vllm:num_requests_running{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" "${query_time}")
  RESULT_PEAK_ACTIVE_REQUESTS=$(experiment_prometheus_query_scalar "max_over_time(((sum(vllm:num_requests_running{namespace=\"${APP_NAMESPACE}\"}) + sum(vllm:num_requests_waiting{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s]))" "${query_time}")
  collect_experiment_histogram_quantile_metric RESULT_P50_SERVER_QUEUE_SECONDS 0.50 "${window}" "${query_time}" vllm:request_queue_time_seconds_bucket vllm_request_queue_time_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P95_SERVER_QUEUE_SECONDS 0.95 "${window}" "${query_time}" vllm:request_queue_time_seconds_bucket vllm_request_queue_time_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P50_SERVER_PREFILL_SECONDS 0.50 "${window}" "${query_time}" vllm:request_prefill_time_seconds_bucket vllm_request_prefill_time_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P95_SERVER_PREFILL_SECONDS 0.95 "${window}" "${query_time}" vllm:request_prefill_time_seconds_bucket vllm_request_prefill_time_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P50_SERVER_DECODE_SECONDS 0.50 "${window}" "${query_time}" vllm:request_decode_time_seconds_bucket vllm_request_decode_time_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P95_SERVER_DECODE_SECONDS 0.95 "${window}" "${query_time}" vllm:request_decode_time_seconds_bucket vllm_request_decode_time_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P50_SERVER_TTFT_SECONDS 0.50 "${window}" "${query_time}" vllm:time_to_first_token_seconds_bucket vllm_time_to_first_token_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P95_SERVER_TTFT_SECONDS 0.95 "${window}" "${query_time}" vllm:time_to_first_token_seconds_bucket vllm_time_to_first_token_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P50_SERVER_INTER_TOKEN_LATENCY_SECONDS 0.50 "${window}" "${query_time}" vllm:time_per_output_token_seconds_bucket vllm_time_per_output_token_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P95_SERVER_INTER_TOKEN_LATENCY_SECONDS 0.95 "${window}" "${query_time}" vllm:time_per_output_token_seconds_bucket vllm_time_per_output_token_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P50_SERVER_E2E_REQUEST_LATENCY_SECONDS 0.50 "${window}" "${query_time}" vllm:e2e_request_latency_seconds_bucket vllm_e2e_request_latency_seconds_bucket
  collect_experiment_histogram_quantile_metric RESULT_P95_SERVER_E2E_REQUEST_LATENCY_SECONDS 0.95 "${window}" "${query_time}" vllm:e2e_request_latency_seconds_bucket vllm_e2e_request_latency_seconds_bucket
  RESULT_AVERAGE_GPU_UTILIZATION_PERCENT=$(experiment_prometheus_query_scalar "avg_over_time((avg(DCGM_FI_DEV_GPU_UTIL))[${window}:1m])" "${query_time}")
  RESULT_MAX_GPU_UTILIZATION_PERCENT=$(experiment_prometheus_query_scalar "max_over_time((max(DCGM_FI_DEV_GPU_UTIL))[${window}:1m])" "${query_time}")
  RESULT_GPU_MEMORY_USED_BYTES=$(experiment_prometheus_query_scalar "avg_over_time((avg(DCGM_FI_DEV_FB_USED) * 1048576)[${window}:1m])" "${query_time}")
  RESULT_GPU_MEMORY_FREE_BYTES=$(experiment_prometheus_query_scalar "avg_over_time((avg(DCGM_FI_DEV_FB_FREE) * 1048576)[${window}:1m])" "${query_time}")
  collect_experiment_first_scalar_query RESULT_KV_CACHE_ACTIVE_BLOCKS "${query_time}" \
    "avg_over_time((avg(vllm:kv_cache_active_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" \
    "avg_over_time((avg(vllm_kv_cache_active_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" \
    "avg_over_time((avg(vllm:gpu_cache_active_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" \
    "avg_over_time((avg(vllm_gpu_cache_active_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])"
  collect_experiment_first_scalar_query RESULT_KV_CACHE_FREE_BLOCKS "${query_time}" \
    "avg_over_time((avg(vllm:kv_cache_free_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" \
    "avg_over_time((avg(vllm_kv_cache_free_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" \
    "avg_over_time((avg(vllm:gpu_cache_free_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" \
    "avg_over_time((avg(vllm_gpu_cache_free_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])"
  collect_experiment_first_scalar_query RESULT_KV_CACHE_FRAGMENTED_BLOCKS "${query_time}" \
    "avg_over_time((avg(vllm:kv_cache_fragmented_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" \
    "avg_over_time((avg(vllm_kv_cache_fragmented_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" \
    "avg_over_time((avg(vllm:gpu_cache_fragmented_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])" \
    "avg_over_time((avg(vllm_gpu_cache_fragmented_blocks{namespace=\"${APP_NAMESPACE}\"}))[${window}:15s])"
  collect_experiment_first_scalar_query RESULT_KV_CACHE_MEMORY_UTILIZATION_PERCENT "${query_time}" \
    "avg_over_time((avg(vllm:kv_cache_usage_perc{namespace=\"${APP_NAMESPACE}\"}) * 100)[${window}:15s])" \
    "avg_over_time((avg(vllm_kv_cache_usage_perc{namespace=\"${APP_NAMESPACE}\"}) * 100)[${window}:15s])" \
    "avg_over_time((avg(vllm:gpu_cache_usage_perc{namespace=\"${APP_NAMESPACE}\"}) * 100)[${window}:15s])" \
    "avg_over_time((avg(vllm_gpu_cache_usage_perc{namespace=\"${APP_NAMESPACE}\"}) * 100)[${window}:15s])"
  collect_experiment_first_scalar_query RESULT_KV_CACHE_HIT_TOKENS "${query_time}" \
    "sum(increase(vllm:prefix_cache_hits_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm_prefix_cache_hits_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm:prompt_tokens_cached_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm_prompt_tokens_cached_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm:gpu_prefix_cache_hits_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm:gpu_prefix_cache_hits{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm_gpu_prefix_cache_hits_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))"
  collect_experiment_first_scalar_query kv_cache_query_tokens "${query_time}" \
    "sum(increase(vllm:prefix_cache_queries_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm_prefix_cache_queries_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm:prompt_tokens_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm_prompt_tokens_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm:gpu_prefix_cache_queries_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm:gpu_prefix_cache_queries{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm_gpu_prefix_cache_queries_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))"
  collect_experiment_first_scalar_query RESULT_KV_CACHE_EVICTIONS "${query_time}" \
    "sum(increase(vllm:kv_cache_evictions_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm_kv_cache_evictions_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))"
  collect_experiment_first_scalar_query RESULT_KV_CACHE_RELOADS "${query_time}" \
    "sum(increase(vllm:kv_cache_reloads_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))" \
    "sum(increase(vllm_kv_cache_reloads_total{namespace=\"${APP_NAMESPACE}\"}[${window}]))"

  if [[ -n "${RESULT_KV_CACHE_HIT_TOKENS:-}" && -n "${kv_cache_query_tokens}" ]]; then
    RESULT_KV_CACHE_MISS_TOKENS=$(awk -v queries="${kv_cache_query_tokens}" -v hits="${RESULT_KV_CACHE_HIT_TOKENS}" 'BEGIN {
      misses = queries - hits
      if (misses < 0) {
        misses = 0
      }
      printf "%.6f", misses
    }')
    RESULT_KV_CACHE_HIT_RATE=$(awk -v queries="${kv_cache_query_tokens}" -v hits="${RESULT_KV_CACHE_HIT_TOKENS}" 'BEGIN {
      if (queries <= 0) {
        printf ""
      } else {
        printf "%.6f", hits / queries
      }
    }')
  fi

  if [[ -n "${EXPERIMENT_KV_CACHE_TOTAL_BLOCKS:-}" && -z "${RESULT_KV_CACHE_TOTAL_BLOCKS:-}" ]]; then
    RESULT_KV_CACHE_TOTAL_BLOCKS=${EXPERIMENT_KV_CACHE_TOTAL_BLOCKS}
  elif [[ -z "${RESULT_KV_CACHE_TOTAL_BLOCKS:-}" && -n "${RESULT_KV_CACHE_ACTIVE_BLOCKS:-}" && -n "${RESULT_KV_CACHE_FREE_BLOCKS:-}" ]]; then
    RESULT_KV_CACHE_TOTAL_BLOCKS=$(awk -v active="${RESULT_KV_CACHE_ACTIVE_BLOCKS}" -v free="${RESULT_KV_CACHE_FREE_BLOCKS}" 'BEGIN {
      printf "%.6f", active + free
    }')
  fi

  if [[ -n "${RESULT_KV_CACHE_TOTAL_BLOCKS:-}" && -n "${RESULT_KV_CACHE_MEMORY_UTILIZATION_PERCENT:-}" &&
    -z "${RESULT_KV_CACHE_ACTIVE_BLOCKS:-}" && -z "${RESULT_KV_CACHE_FREE_BLOCKS:-}" ]]; then
    RESULT_KV_CACHE_ACTIVE_BLOCKS=$(awk -v total="${RESULT_KV_CACHE_TOTAL_BLOCKS}" -v usage="${RESULT_KV_CACHE_MEMORY_UTILIZATION_PERCENT}" 'BEGIN {
      printf "%d", int((total * usage / 100) + 0.5)
    }')
    RESULT_KV_CACHE_FREE_BLOCKS=$(awk -v total="${RESULT_KV_CACHE_TOTAL_BLOCKS}" -v active="${RESULT_KV_CACHE_ACTIVE_BLOCKS}" 'BEGIN {
      free = total - active
      if (free < 0) {
        free = 0
      }
      printf "%d", free
    }')
    RESULT_KV_CACHE_SOURCE="derived"
  elif [[ -n "${RESULT_KV_CACHE_ACTIVE_BLOCKS:-}${RESULT_KV_CACHE_FREE_BLOCKS:-}${RESULT_KV_CACHE_FRAGMENTED_BLOCKS:-}${RESULT_KV_CACHE_MEMORY_UTILIZATION_PERCENT:-}${RESULT_KV_CACHE_HIT_TOKENS:-}${RESULT_KV_CACHE_EVICTIONS:-}${RESULT_KV_CACHE_RELOADS:-}" ]]; then
    RESULT_KV_CACHE_SOURCE="observed"
  else
    RESULT_KV_CACHE_SOURCE="unavailable"
  fi

  stop_experiment_prometheus_port_forward
}

parse_k6_summary_log() {
  local log_path=$1
  local in_summary=0
  local key
  local value
  local footer_interrupted_iterations
  local calculated_buffering_required

  RESULT_COMPLETED_REQUESTS=""
  RESULT_SUCCESSFUL_REQUESTS=""
  RESULT_FAILED_REQUESTS=""
  RESULT_DROPPED_ITERATIONS=""
  RESULT_INTERRUPTED_ITERATIONS=""
  RESULT_BUFFERING_REQUIRED_REQUESTS=""
  RESULT_FAILURE_ATTRIBUTION=""
  RESULT_P50_REQUEST_LATENCY_SECONDS=""
  RESULT_P95_REQUEST_LATENCY_SECONDS=""
  RESULT_P99_REQUEST_LATENCY_SECONDS=""
  RESULT_P50_CLIENT_WAITING_SECONDS=""
  RESULT_P95_CLIENT_WAITING_SECONDS=""
  RESULT_P99_CLIENT_WAITING_SECONDS=""
  RESULT_P95_CLIENT_BLOCKED_SECONDS=""
  RESULT_P95_CLIENT_CONNECTING_SECONDS=""
  RESULT_P95_CLIENT_TLS_HANDSHAKING_SECONDS=""
  RESULT_P95_CLIENT_SENDING_SECONDS=""
  RESULT_P95_CLIENT_RECEIVING_SECONDS=""
  RESULT_REQUESTS_PER_SECOND=""
  RESULT_GENERATED_TOKENS=""
  RESULT_GENERATION_TOKENS_PER_SECOND=""
  RESULT_RUN_DURATION_SECONDS=""

  while IFS= read -r line; do
    case "${line}" in
      GPU_LAB_K6_SUMMARY_BEGIN)
        in_summary=1
        continue
        ;;
      GPU_LAB_K6_SUMMARY_END)
        in_summary=0
        continue
        ;;
    esac

    if [[ "${in_summary}" != "1" || "${line}" != *=* ]]; then
      continue
    fi

    key=${line%%=*}
    value=${line#*=}
    case "${key}" in
      completed_requests)
        RESULT_COMPLETED_REQUESTS=${value}
        ;;
      failed_requests)
        RESULT_FAILED_REQUESTS=${value}
        ;;
      generated_tokens)
        RESULT_GENERATED_TOKENS=${value}
        ;;
      dropped_iterations)
        RESULT_DROPPED_ITERATIONS=${value}
        ;;
      interrupted_iterations)
        RESULT_INTERRUPTED_ITERATIONS=${value}
        ;;
      buffering_required_requests)
        RESULT_BUFFERING_REQUIRED_REQUESTS=${value}
        ;;
      p50_request_latency_seconds)
        RESULT_P50_REQUEST_LATENCY_SECONDS=${value}
        ;;
      p95_request_latency_seconds)
        RESULT_P95_REQUEST_LATENCY_SECONDS=${value}
        ;;
      p99_request_latency_seconds)
        RESULT_P99_REQUEST_LATENCY_SECONDS=${value}
        ;;
      p50_client_waiting_seconds)
        RESULT_P50_CLIENT_WAITING_SECONDS=${value}
        ;;
      p95_client_waiting_seconds)
        RESULT_P95_CLIENT_WAITING_SECONDS=${value}
        ;;
      p99_client_waiting_seconds)
        RESULT_P99_CLIENT_WAITING_SECONDS=${value}
        ;;
      p95_client_blocked_seconds)
        RESULT_P95_CLIENT_BLOCKED_SECONDS=${value}
        ;;
      p95_client_connecting_seconds)
        RESULT_P95_CLIENT_CONNECTING_SECONDS=${value}
        ;;
      p95_client_tls_handshaking_seconds)
        RESULT_P95_CLIENT_TLS_HANDSHAKING_SECONDS=${value}
        ;;
      p95_client_sending_seconds)
        RESULT_P95_CLIENT_SENDING_SECONDS=${value}
        ;;
      p95_client_receiving_seconds)
        RESULT_P95_CLIENT_RECEIVING_SECONDS=${value}
        ;;
      requests_per_second)
        RESULT_REQUESTS_PER_SECOND=${value}
        ;;
      generation_tokens_per_second)
        RESULT_GENERATION_TOKENS_PER_SECOND=${value}
        ;;
      run_duration_seconds)
        RESULT_RUN_DURATION_SECONDS=${value}
        ;;
    esac
  done < "${log_path}"

  footer_interrupted_iterations=$(awk '
    /interrupted iterations/ {
      for (field_index = 1; field_index <= NF; field_index++) {
        if ($field_index == "interrupted" && field_index > 1) {
          interrupted = $(field_index - 1)
        }
      }
    }
    END { print interrupted }
  ' "${log_path}")
  RESULT_INTERRUPTED_ITERATIONS=$(max_optional_integer_values "${RESULT_INTERRUPTED_ITERATIONS}" "${footer_interrupted_iterations}")

  calculated_buffering_required=$(sum_optional_integer_values "${RESULT_DROPPED_ITERATIONS}" "${RESULT_INTERRUPTED_ITERATIONS}")
  if [[ -n "${calculated_buffering_required}" ]]; then
    RESULT_BUFFERING_REQUIRED_REQUESTS=$(max_optional_integer_values "${RESULT_BUFFERING_REQUIRED_REQUESTS}" "${calculated_buffering_required}")
  fi

  if [[ -n "${RESULT_COMPLETED_REQUESTS}" ]]; then
    if [[ -z "${RESULT_DROPPED_ITERATIONS}" ]]; then
      RESULT_DROPPED_ITERATIONS=0
    fi
    if [[ -z "${RESULT_INTERRUPTED_ITERATIONS}" ]]; then
      RESULT_INTERRUPTED_ITERATIONS=0
    fi
    if [[ -z "${RESULT_BUFFERING_REQUIRED_REQUESTS}" ]]; then
      RESULT_BUFFERING_REQUIRED_REQUESTS=$(sum_optional_integer_values "${RESULT_DROPPED_ITERATIONS}" "${RESULT_INTERRUPTED_ITERATIONS}")
    fi
  fi

  if [[ -n "${RESULT_DROPPED_ITERATIONS}" ]] && awk -v value="${RESULT_DROPPED_ITERATIONS}" 'BEGIN { exit !((value + 0) > 0) }'; then
    RESULT_FAILURE_ATTRIBUTION="client_queue_limit"
  elif [[ -n "${RESULT_INTERRUPTED_ITERATIONS}" ]] && awk -v value="${RESULT_INTERRUPTED_ITERATIONS}" 'BEGIN { exit !((value + 0) > 0) }'; then
    RESULT_FAILURE_ATTRIBUTION="client_graceful_stop_limit"
  elif [[ -n "${RESULT_FAILED_REQUESTS}" ]] && awk -v value="${RESULT_FAILED_REQUESTS}" 'BEGIN { exit !((value + 0) > 0) }'; then
    RESULT_FAILURE_ATTRIBUTION="serving_or_provisioning"
  elif [[ -n "${RESULT_COMPLETED_REQUESTS}" ]]; then
    RESULT_FAILURE_ATTRIBUTION="none"
  fi
}

parse_stream_summary_log() {
  local log_path=$1
  local in_summary=0
  local key
  local value

  RESULT_COMPLETED_REQUESTS=""
  RESULT_SUCCESSFUL_REQUESTS=""
  RESULT_FAILED_REQUESTS=""
  RESULT_P50_REQUEST_LATENCY_SECONDS=""
  RESULT_P95_REQUEST_LATENCY_SECONDS=""
  RESULT_P99_REQUEST_LATENCY_SECONDS=""
  RESULT_P50_CLIENT_WAITING_SECONDS=""
  RESULT_P95_CLIENT_WAITING_SECONDS=""
  RESULT_P99_CLIENT_WAITING_SECONDS=""
  RESULT_P95_CLIENT_BLOCKED_SECONDS=""
  RESULT_P95_CLIENT_CONNECTING_SECONDS=""
  RESULT_P95_CLIENT_TLS_HANDSHAKING_SECONDS=""
  RESULT_P95_CLIENT_SENDING_SECONDS=""
  RESULT_P95_CLIENT_RECEIVING_SECONDS=""
  RESULT_P50_TTFT_SECONDS=""
  RESULT_P95_TTFT_SECONDS=""
  RESULT_P50_INTER_TOKEN_LATENCY_SECONDS=""
  RESULT_P95_INTER_TOKEN_LATENCY_SECONDS=""
  RESULT_GENERATION_TOKENS_PER_SECOND=""
  RESULT_RUN_DURATION_SECONDS=""
  RESULT_STREAM_SHAPE_SUMMARIES_JSON=""
  STREAM_SAMPLES=""
  STREAM_CONCURRENCY=""
  STREAM_SHAPE_SUMMARY_ROWS=""

  while IFS= read -r line; do
    case "${line}" in
      GPU_LAB_STREAM_SUMMARY_BEGIN)
        in_summary=1
        continue
        ;;
      GPU_LAB_STREAM_SUMMARY_END)
        in_summary=0
        continue
        ;;
    esac

    if [[ "${in_summary}" != "1" || "${line}" != *=* ]]; then
      continue
    fi

    key=${line%%=*}
    value=${line#*=}
    case "${key}" in
      stream_samples)
        STREAM_SAMPLES=${value}
        ;;
      stream_concurrency)
        STREAM_CONCURRENCY=${value}
        ;;
      stream_shape_summaries)
        RESULT_STREAM_SHAPE_SUMMARIES_JSON=${value}
        ;;
      stream_shape_summary_row)
        STREAM_SHAPE_SUMMARY_ROWS+="${value}"$'\n'
        ;;
      completed_requests)
        RESULT_COMPLETED_REQUESTS=${value}
        ;;
      failed_requests)
        RESULT_FAILED_REQUESTS=${value}
        ;;
      p50_request_latency_seconds)
        RESULT_P50_REQUEST_LATENCY_SECONDS=${value}
        ;;
      p95_request_latency_seconds)
        RESULT_P95_REQUEST_LATENCY_SECONDS=${value}
        ;;
      p99_request_latency_seconds)
        RESULT_P99_REQUEST_LATENCY_SECONDS=${value}
        ;;
      p50_ttft_seconds)
        RESULT_P50_TTFT_SECONDS=${value}
        ;;
      p95_ttft_seconds)
        RESULT_P95_TTFT_SECONDS=${value}
        ;;
      p50_inter_token_latency_seconds)
        RESULT_P50_INTER_TOKEN_LATENCY_SECONDS=${value}
        ;;
      p95_inter_token_latency_seconds)
        RESULT_P95_INTER_TOKEN_LATENCY_SECONDS=${value}
        ;;
      generation_tokens_per_second)
        RESULT_GENERATION_TOKENS_PER_SECOND=${value}
        ;;
      run_duration_seconds)
        RESULT_RUN_DURATION_SECONDS=${value}
        ;;
    esac
  done < "${log_path}"
}

derive_successful_requests() {
  if [[ -z "${RESULT_COMPLETED_REQUESTS:-}" ]]; then
    RESULT_SUCCESSFUL_REQUESTS=""
    return 0
  fi

  awk \
    -v completed="${RESULT_COMPLETED_REQUESTS}" \
    -v failed="${RESULT_FAILED_REQUESTS:-0}" '
      BEGIN {
        successful = (completed + 0) - (failed + 0)
        if (successful < 0) {
          successful = 0
        }
        printf "%.0f\n", successful
	    }'
}

derive_demand_metrics() {
  RESULT_OFFERED_ITERATIONS=""
  RESULT_UNSERVED_ITERATIONS=""
  RESULT_DELIVERY_RATIO=""

  if [[ -z "${RESULT_COMPLETED_REQUESTS:-}" ]]; then
    return 0
  fi

  RESULT_OFFERED_ITERATIONS=$(awk \
    -v completed="${RESULT_COMPLETED_REQUESTS}" \
    -v dropped="${RESULT_DROPPED_ITERATIONS:-0}" \
    -v interrupted="${RESULT_INTERRUPTED_ITERATIONS:-0}" '
      BEGIN { printf "%.0f\n", (completed + 0) + (dropped + 0) + (interrupted + 0) }')

  RESULT_UNSERVED_ITERATIONS=$(awk \
    -v failed="${RESULT_FAILED_REQUESTS:-0}" \
    -v dropped="${RESULT_DROPPED_ITERATIONS:-0}" \
    -v interrupted="${RESULT_INTERRUPTED_ITERATIONS:-0}" '
      BEGIN { printf "%.0f\n", (failed + 0) + (dropped + 0) + (interrupted + 0) }')

  RESULT_DELIVERY_RATIO=$(divide_decimal_values "${RESULT_SUCCESSFUL_REQUESTS:-}" "${RESULT_OFFERED_ITERATIONS}" 6)
}

derive_slo_passed() {
  local evaluated=0
  local failed=0

  RESULT_SLO_PASSED=""

  if [[ -n "${COST_SLO_P95_REQUEST_LATENCY_SECONDS:-}" && -n "${RESULT_P95_REQUEST_LATENCY_SECONDS:-}" ]]; then
    evaluated=1
    if ! awk -v actual="${RESULT_P95_REQUEST_LATENCY_SECONDS}" -v target="${COST_SLO_P95_REQUEST_LATENCY_SECONDS}" 'BEGIN { exit !((actual + 0) <= (target + 0)) }'; then
      failed=1
    fi
  fi

  if [[ -n "${COST_SLO_P99_REQUEST_LATENCY_SECONDS:-}" && -n "${RESULT_P99_REQUEST_LATENCY_SECONDS:-}" ]]; then
    evaluated=1
    if ! awk -v actual="${RESULT_P99_REQUEST_LATENCY_SECONDS}" -v target="${COST_SLO_P99_REQUEST_LATENCY_SECONDS}" 'BEGIN { exit !((actual + 0) <= (target + 0)) }'; then
      failed=1
    fi
  fi

  if [[ "${evaluated}" == "0" ]]; then
    return 0
  fi

  if [[ "${failed}" == "1" ]]; then
    RESULT_SLO_PASSED="false"
  else
    RESULT_SLO_PASSED="true"
  fi
}

derive_cost_metrics() {
  local experiment_name=$1
  local profile_id=$2
  local duration_seconds

  load_cost_profile "${experiment_name}" "${profile_id}"
  load_cost_detail_profile "${experiment_name}" "${profile_id}"

  RESULT_SUCCESSFUL_REQUESTS=$(derive_successful_requests)
  derive_demand_metrics
  RESULT_ESTIMATED_BURST_COST_USD=""
  RESULT_ESTIMATED_SERVING_COST_USD=""
  RESULT_COST_PER_1000_SUCCESSFUL_REQUESTS_USD=""
  RESULT_COST_PER_1K_SUCCESSFUL_REQUESTS_USD=""
  RESULT_COST_PER_1M_GENERATED_TOKENS_USD=""
  RESULT_COST_PER_ACCURACY_POINT_USD=""
  RESULT_COST_PER_ACCURACY_RECOVERED_PERCENT_USD=""
  RESULT_QUANTIZATION_BUILD_COST_USD="${COST_QUANTIZATION_BUILD_COST_USD:-}"
  RESULT_SLO_PASSED=""

  if [[ -z "${RESULT_RUN_DURATION_SECONDS:-}" && -n "${CASE_ID:-}" ]]; then
    RESULT_RUN_DURATION_SECONDS=$(case_planned_duration_seconds)
  fi

  duration_seconds=${RESULT_RUN_DURATION_SECONDS:-}
  if [[ -n "${COST_SERVING_HOURLY_COST_USD:-}" && -n "${duration_seconds}" ]]; then
    RESULT_ESTIMATED_BURST_COST_USD=$(awk \
      -v hourly="${COST_SERVING_HOURLY_COST_USD}" \
      -v duration="${duration_seconds}" \
      'BEGIN { printf "%.6f\n", ((hourly + 0) * (duration + 0)) / 3600 }')
    RESULT_ESTIMATED_SERVING_COST_USD=${RESULT_ESTIMATED_BURST_COST_USD}
  fi

  if [[ -n "${RESULT_ESTIMATED_BURST_COST_USD}" && -n "${RESULT_SUCCESSFUL_REQUESTS}" ]]; then
    RESULT_COST_PER_1000_SUCCESSFUL_REQUESTS_USD=$(divide_decimal_values \
      "$(multiply_decimal_values "${RESULT_ESTIMATED_BURST_COST_USD}" "1000" 6)" \
      "${RESULT_SUCCESSFUL_REQUESTS}" \
      6)
    RESULT_COST_PER_1K_SUCCESSFUL_REQUESTS_USD=${RESULT_COST_PER_1000_SUCCESSFUL_REQUESTS_USD}
  fi

  if [[ -n "${RESULT_ESTIMATED_BURST_COST_USD}" && -n "${RESULT_GENERATED_TOKENS:-}" ]]; then
    RESULT_COST_PER_1M_GENERATED_TOKENS_USD=$(divide_decimal_values \
      "$(multiply_decimal_values "${RESULT_ESTIMATED_BURST_COST_USD}" "1000000" 6)" \
      "${RESULT_GENERATED_TOKENS}" \
      6)
  fi

  if [[ -n "${RESULT_ESTIMATED_SERVING_COST_USD}" && -n "${RESULT_ACCURACY_AVERAGE_SCORE:-}" ]]; then
    RESULT_COST_PER_ACCURACY_POINT_USD=$(divide_decimal_values \
      "${RESULT_ESTIMATED_SERVING_COST_USD}" \
      "${RESULT_ACCURACY_AVERAGE_SCORE}" \
      6)
  fi

  if [[ -n "${RESULT_ESTIMATED_SERVING_COST_USD}" && -n "${RESULT_FP4_RECOVERY_VS_BF16_PERCENT:-}" ]]; then
    RESULT_COST_PER_ACCURACY_RECOVERED_PERCENT_USD=$(divide_decimal_values \
      "${RESULT_ESTIMATED_SERVING_COST_USD}" \
      "${RESULT_FP4_RECOVERY_VS_BF16_PERCENT}" \
      6)
  fi

  derive_slo_passed
}

detect_vllm_oom_events() {
  local reasons
  local count

  reasons=$(kubectl get pods \
    -n "${APP_NAMESPACE}" \
    -l "app=${GPU_INFERENCE_DEPLOYMENT_NAME}" \
    -o jsonpath='{range .items[*]}{range .status.containerStatuses[*]}{.state.terminated.reason}{"\n"}{.lastState.terminated.reason}{"\n"}{end}{end}' 2>/dev/null || true)

  if [[ -z "${reasons}" ]]; then
    return 0
  fi

  count=$(printf '%s\n' "${reasons}" | awk '$0 == "OOMKilled" { count++ } END { print count + 0 }')
  RESULT_OOM_EVENTS=${count}
}

wait_for_experiment_job_completion() {
  local namespace=$1
  local job_name=$2
  local timeout_seconds=$3
  local start_time
  local complete_status
  local failed_status
  local failed_reason
  local failed_message

  start_time=$(date +%s)

  while true; do
    complete_status=$(kubectl get "job/${job_name}" \
      -n "${namespace}" \
      -o "jsonpath={.status.conditions[?(@.type=='Complete')].status}" 2>/dev/null || true)
    if [[ "${complete_status}" == "True" ]]; then
      return 0
    fi

    failed_status=$(kubectl get "job/${job_name}" \
      -n "${namespace}" \
      -o "jsonpath={.status.conditions[?(@.type=='Failed')].status}" 2>/dev/null || true)
    if [[ "${failed_status}" == "True" ]]; then
      failed_reason=$(kubectl get "job/${job_name}" \
        -n "${namespace}" \
        -o "jsonpath={.status.conditions[?(@.type=='Failed')].reason}" 2>/dev/null || true)
      failed_message=$(kubectl get "job/${job_name}" \
        -n "${namespace}" \
        -o "jsonpath={.status.conditions[?(@.type=='Failed')].message}" 2>/dev/null || true)

      printf 'Job %s/%s failed' "${namespace}" "${job_name}" >&2
      if [[ -n "${failed_reason}" ]]; then
        printf ': %s' "${failed_reason}" >&2
      fi
      if [[ -n "${failed_message}" ]]; then
        printf ' - %s' "${failed_message}" >&2
      fi
      printf '\n' >&2
      return 1
    fi

    if (( $(date +%s) - start_time >= timeout_seconds )); then
      printf 'Timed out waiting for job %s/%s to complete after %ss\n' \
        "${namespace}" "${job_name}" "${timeout_seconds}" >&2
      return 1
    fi

    sleep "${POLL_INTERVAL_SECONDS}"
  done
}

run_experiment_case() {
  local experiment_name=$1
  local case_id=$2
  local profile_id=$3
  local report_path=$4
  local json_report_path=$5
  local preserve_serving=$6
  local preserve_load=$7
  local serving_manifest
  local load_manifest
  local k6_log_path
  local job_name
  local generated_at
  local job_status

  require_commands kubectl
  require_experiment "${experiment_name}"
  load_case "${experiment_name}" "${case_id}"
  load_serving_profile "${experiment_name}" "${profile_id}"
  validate_case_profile_compatibility "${experiment_name}"

  generated_at=$(utc_timestamp)
  job_name=$(experiment_job_name "${experiment_name}" "${CASE_ID}")
  serving_manifest=$(mktemp "${TMPDIR:-/tmp}/gpu-lab-experiment-serving.XXXXXX")
  load_manifest=$(mktemp "${TMPDIR:-/tmp}/gpu-lab-experiment-load.XXXXXX")
  k6_log_path="${json_report_path%.json}.k6.log"

  render_serving_manifest "${experiment_name}" "${profile_id}" > "${serving_manifest}"
  render_load_manifest "${experiment_name}" "${case_id}" > "${load_manifest}"

  printf 'Applying service manifest: %s\n' "${GPU_INFERENCE_SERVICE_MANIFEST}"
  kubectl apply -f "${GPU_INFERENCE_SERVICE_MANIFEST}"

  printf 'Applying serving profile %s/%s\n' "${experiment_name}" "${profile_id}"
  EXPERIMENT_SERVING_START_EPOCH_SECONDS=$(date +%s)
  kubectl apply -f "${serving_manifest}"
  collect_experiment_autoscaling_timeline "${experiment_name}"
  kubectl rollout status "deployment/${GPU_INFERENCE_DEPLOYMENT_NAME}" -n "${APP_NAMESPACE}" --timeout=20m
  record_experiment_model_ready_timeline "${experiment_name}"
  wait_for_experiment_dcgm_metrics

  printf 'Applying load case %s/%s\n' "${experiment_name}" "${CASE_ID}"
  EXPERIMENT_LOAD_START_EPOCH_SECONDS=$(date +%s)
  kubectl apply -f "${load_manifest}"

  set +e
  wait_for_experiment_job_completion "${APP_NAMESPACE}" "${job_name}" "${EVALUATE_LOAD_TIMEOUT_SECONDS}"
  job_status=$?
  set -e
  EXPERIMENT_LOAD_END_EPOCH_SECONDS=$(date +%s)

  mkdir -p "$(dirname "${k6_log_path}")"
  kubectl logs -n "${APP_NAMESPACE}" "job/${job_name}" > "${k6_log_path}" 2>/dev/null || true
  if [[ -s "${k6_log_path}" ]]; then
    parse_k6_summary_log "${k6_log_path}"
  fi
  detect_vllm_oom_events
  collect_experiment_observability_metrics
  derive_cost_metrics "${experiment_name}" "${PROFILE_ID}"

  if [[ "${job_status}" == "0" ]]; then
    RUN_STATUS="complete"
  else
    RUN_STATUS="failed"
  fi
  RUN_SOURCE="scripts/experiment run"

  write_report_files "${experiment_name}" "${CASE_ID}" "${PROFILE_ID}" "${report_path}" "${json_report_path}" "${generated_at}"

  if [[ "${preserve_load}" != "1" ]]; then
    kubectl delete -f "${load_manifest}" --ignore-not-found=true >/dev/null 2>&1 || true
  fi

  if [[ "${preserve_serving}" != "1" ]]; then
    kubectl delete -f "${serving_manifest}" --ignore-not-found=true >/dev/null 2>&1 || true
  fi

  rm -f "${serving_manifest}" "${load_manifest}" || true

  printf 'Experiment run status: %s\n' "${RUN_STATUS}"
  printf 'K6 log: %s\n' "${k6_log_path}"
  printf 'Markdown report: %s\n' "${report_path}"
  printf 'JSON report: %s\n' "${json_report_path}"

  return "${job_status}"
}

run_stream_case() {
  local experiment_name=$1
  local case_id=$2
  local profile_id=$3
  local samples=$4
  local stream_concurrency=$5
  local report_path=$6
  local json_report_path=$7
  local preserve_serving=$8
  local preserve_load=$9
  local serving_manifest
  local stream_manifest
  local stream_log_path
  local job_name
  local generated_at
  local job_status

  require_commands kubectl
  require_experiment "${experiment_name}"
  load_case "${experiment_name}" "${case_id}"
  load_serving_profile "${experiment_name}" "${profile_id}"
  require_positive_integer "${samples}" "stream samples"
  require_positive_integer "${stream_concurrency}" "stream concurrency"
  validate_case_profile_compatibility "${experiment_name}"

  generated_at=$(utc_timestamp)
  job_name=$(stream_job_name "${experiment_name}" "${CASE_ID}")
  serving_manifest=$(mktemp "${TMPDIR:-/tmp}/gpu-lab-experiment-serving.XXXXXX")
  stream_manifest=$(mktemp "${TMPDIR:-/tmp}/gpu-lab-experiment-stream.XXXXXX")
  stream_log_path="${json_report_path%.json}.stream.log"

  render_serving_manifest "${experiment_name}" "${profile_id}" > "${serving_manifest}"
  render_stream_manifest "${experiment_name}" "${case_id}" "${samples}" "${stream_concurrency}" > "${stream_manifest}"

  printf 'Applying service manifest: %s\n' "${GPU_INFERENCE_SERVICE_MANIFEST}"
  kubectl apply -f "${GPU_INFERENCE_SERVICE_MANIFEST}"

  printf 'Applying serving profile %s/%s\n' "${experiment_name}" "${profile_id}"
  EXPERIMENT_SERVING_START_EPOCH_SECONDS=$(date +%s)
  kubectl apply -f "${serving_manifest}"
  collect_experiment_autoscaling_timeline "${experiment_name}"
  kubectl rollout status "deployment/${GPU_INFERENCE_DEPLOYMENT_NAME}" -n "${APP_NAMESPACE}" --timeout=20m
  record_experiment_model_ready_timeline "${experiment_name}"
  wait_for_experiment_dcgm_metrics

  printf 'Applying streaming case %s/%s with %s sample(s), concurrency %s\n' "${experiment_name}" "${CASE_ID}" "${samples}" "${stream_concurrency}"
  EXPERIMENT_LOAD_START_EPOCH_SECONDS=$(date +%s)
  kubectl apply -f "${stream_manifest}"

  set +e
  wait_for_experiment_job_completion "${APP_NAMESPACE}" "${job_name}" "${EVALUATE_LOAD_TIMEOUT_SECONDS}"
  job_status=$?
  set -e
  EXPERIMENT_LOAD_END_EPOCH_SECONDS=$(date +%s)

  mkdir -p "$(dirname "${stream_log_path}")"
  kubectl logs -n "${APP_NAMESPACE}" "job/${job_name}" > "${stream_log_path}" 2>/dev/null || true
  if [[ -s "${stream_log_path}" ]]; then
    parse_stream_summary_log "${stream_log_path}"
  fi
  STREAM_SAMPLES=${STREAM_SAMPLES:-${samples}}
  STREAM_CONCURRENCY=${STREAM_CONCURRENCY:-${stream_concurrency}}
  detect_vllm_oom_events
  collect_experiment_observability_metrics
  derive_cost_metrics "${experiment_name}" "${PROFILE_ID}"

  if [[ "${job_status}" == "0" ]]; then
    RUN_STATUS="complete"
  else
    RUN_STATUS="failed"
  fi
  RUN_SOURCE="scripts/experiment run-stream"

  write_report_files "${experiment_name}" "${CASE_ID}" "${PROFILE_ID}" "${report_path}" "${json_report_path}" "${generated_at}"

  if [[ "${preserve_load}" != "1" ]]; then
    kubectl delete -f "${stream_manifest}" --ignore-not-found=true >/dev/null 2>&1 || true
  fi

  if [[ "${preserve_serving}" != "1" ]]; then
    kubectl delete -f "${serving_manifest}" --ignore-not-found=true >/dev/null 2>&1 || true
  fi

  rm -f "${serving_manifest}" "${stream_manifest}" || true

  printf 'Streaming experiment run status: %s\n' "${RUN_STATUS}"
  printf 'Stream log: %s\n' "${stream_log_path}"
  printf 'Markdown report: %s\n' "${report_path}"
  printf 'JSON report: %s\n' "${json_report_path}"

  return "${job_status}"
}

render_load_command() {
  local experiment_name=""
  local case_id=""
  local output_path=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --experiment)
        experiment_name=$(require_option_value "$1" "${2-}")
        shift 2
        ;;
      --case)
        case_id=$(require_option_value "$1" "${2-}")
        shift 2
        ;;
      --output)
        output_path=$(require_option_value "$1" "${2-}")
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unexpected argument: $1"
        ;;
    esac
  done

  if [[ -z "${experiment_name}" ]]; then
    die "render-load requires --experiment"
  fi

  if [[ -z "${case_id}" ]]; then
    die "render-load requires --case"
  fi

  if [[ -n "${output_path}" ]]; then
    render_load_manifest "${experiment_name}" "${case_id}" > "${output_path}"
    printf 'Rendered load manifest: %s\n' "${output_path}"
  else
    render_load_manifest "${experiment_name}" "${case_id}"
  fi
}

