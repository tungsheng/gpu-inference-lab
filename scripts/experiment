  fi
  if [[ -n "${MAX_NUM_BATCHED_TOKENS}" ]]; then
    max_num_batched_tokens_display=${MAX_NUM_BATCHED_TOKENS}
  fi
  if [[ -n "${SERVING_TENSOR_PARALLEL_SIZE}" ]]; then
    tensor_parallel_size_display=${SERVING_TENSOR_PARALLEL_SIZE}
  fi

  completed_requests_display=$(display_optional_metric "${RESULT_COMPLETED_REQUESTS:-}")
  successful_requests_display=$(display_optional_metric "${RESULT_SUCCESSFUL_REQUESTS:-}")
  failed_requests_display=$(display_optional_metric "${RESULT_FAILED_REQUESTS:-}")
  oom_events_display=$(display_optional_metric "${RESULT_OOM_EVENTS:-}")
  offered_iterations_display=$(display_optional_metric "${RESULT_OFFERED_ITERATIONS:-}")
  unserved_iterations_display=$(display_optional_metric "${RESULT_UNSERVED_ITERATIONS:-}")
  delivery_ratio_display=$(display_optional_metric "${RESULT_DELIVERY_RATIO:-}")
  dropped_iterations_display=$(display_optional_metric "${RESULT_DROPPED_ITERATIONS:-}")
  interrupted_iterations_display=$(display_optional_metric "${RESULT_INTERRUPTED_ITERATIONS:-}")
  buffering_required_display=$(display_optional_metric "${RESULT_BUFFERING_REQUIRED_REQUESTS:-}")
  failure_attribution_display=$(display_optional_metric "${RESULT_FAILURE_ATTRIBUTION:-}")
  p50_latency_display=$(display_optional_metric "${RESULT_P50_REQUEST_LATENCY_SECONDS:-}")
  p95_latency_display=$(display_optional_metric "${RESULT_P95_REQUEST_LATENCY_SECONDS:-}")
  p99_latency_display=$(display_optional_metric "${RESULT_P99_REQUEST_LATENCY_SECONDS:-}")
  p50_client_waiting_display=$(display_optional_metric "${RESULT_P50_CLIENT_WAITING_SECONDS:-}")
  p95_client_waiting_display=$(display_optional_metric "${RESULT_P95_CLIENT_WAITING_SECONDS:-}")
  p99_client_waiting_display=$(display_optional_metric "${RESULT_P99_CLIENT_WAITING_SECONDS:-}")
  p95_client_blocked_display=$(display_optional_metric "${RESULT_P95_CLIENT_BLOCKED_SECONDS:-}")
  p95_client_connecting_display=$(display_optional_metric "${RESULT_P95_CLIENT_CONNECTING_SECONDS:-}")
  p95_client_tls_handshaking_display=$(display_optional_metric "${RESULT_P95_CLIENT_TLS_HANDSHAKING_SECONDS:-}")
  p95_client_sending_display=$(display_optional_metric "${RESULT_P95_CLIENT_SENDING_SECONDS:-}")
  p95_client_receiving_display=$(display_optional_metric "${RESULT_P95_CLIENT_RECEIVING_SECONDS:-}")
  p50_server_queue_display=$(display_optional_metric "${RESULT_P50_SERVER_QUEUE_SECONDS:-}")
  p95_server_queue_display=$(display_optional_metric "${RESULT_P95_SERVER_QUEUE_SECONDS:-}")
  p50_server_prefill_display=$(display_optional_metric "${RESULT_P50_SERVER_PREFILL_SECONDS:-}")
  p95_server_prefill_display=$(display_optional_metric "${RESULT_P95_SERVER_PREFILL_SECONDS:-}")
  p50_server_decode_display=$(display_optional_metric "${RESULT_P50_SERVER_DECODE_SECONDS:-}")
  p95_server_decode_display=$(display_optional_metric "${RESULT_P95_SERVER_DECODE_SECONDS:-}")
  p50_server_ttft_display=$(display_optional_metric "${RESULT_P50_SERVER_TTFT_SECONDS:-}")
  p95_server_ttft_display=$(display_optional_metric "${RESULT_P95_SERVER_TTFT_SECONDS:-}")
  p50_server_inter_token_latency_display=$(display_optional_metric "${RESULT_P50_SERVER_INTER_TOKEN_LATENCY_SECONDS:-}")
  p95_server_inter_token_latency_display=$(display_optional_metric "${RESULT_P95_SERVER_INTER_TOKEN_LATENCY_SECONDS:-}")
  p50_server_e2e_latency_display=$(display_optional_metric "${RESULT_P50_SERVER_E2E_REQUEST_LATENCY_SECONDS:-}")
  p95_server_e2e_latency_display=$(display_optional_metric "${RESULT_P95_SERVER_E2E_REQUEST_LATENCY_SECONDS:-}")
  p50_ttft_display=$(display_optional_metric "${RESULT_P50_TTFT_SECONDS:-}")
  p95_ttft_display=$(display_optional_metric "${RESULT_P95_TTFT_SECONDS:-}")
  p50_inter_token_latency_display=$(display_optional_metric "${RESULT_P50_INTER_TOKEN_LATENCY_SECONDS:-}")
  p95_inter_token_latency_display=$(display_optional_metric "${RESULT_P95_INTER_TOKEN_LATENCY_SECONDS:-}")
  requests_per_second_display=$(display_optional_metric "${RESULT_REQUESTS_PER_SECOND:-}")
  generated_tokens_display=$(display_optional_metric "${RESULT_GENERATED_TOKENS:-}")
  generation_tokens_per_second_display=$(display_optional_metric "${RESULT_GENERATION_TOKENS_PER_SECOND:-}")
  run_duration_display=$(display_optional_metric "${RESULT_RUN_DURATION_SECONDS:-}")
  peak_waiting_requests_display=$(display_optional_metric "${RESULT_PEAK_WAITING_REQUESTS:-}")
