  model_artifact_hash_display=$(display_optional_metric "${MODEL_ARTIFACT_HASH:-}")
  recipe_hash_display=$(display_optional_metric "${RECIPE_HASH:-}")
  if [[ -n "${CALIBRATION_DATASET:-}" ]]; then
    calibration_settings_display="dataset=${CALIBRATION_DATASET} split=${CALIBRATION_SPLIT} samples=${CALIBRATION_SAMPLES} max_seq_len=${CALIBRATION_MAX_SEQ_LEN} seed=${CALIBRATION_SEED}"
  fi
  accuracy_case_display=$(display_optional_metric "${ACCURACY_CASE_ID:-}")
  accuracy_tasks_display=$(display_task_list "${ACCURACY_TASKS:-}")
  accuracy_fewshot_display=$(display_optional_metric "${ACCURACY_NUM_FEWSHOT:-}")
  accuracy_limit_display=$(display_optional_metric "${ACCURACY_LIMIT:-}")
  accuracy_metric_display=$(display_optional_metric "${ACCURACY_PRIMARY_METRIC:-}")
