  accuracy_hellaswag_display=$(display_optional_metric "${RESULT_ACCURACY_HELLASWAG:-}")
  accuracy_winogrande_display=$(display_optional_metric "${RESULT_ACCURACY_WINOGRANDE:-}")
  accuracy_average_score_display=$(display_optional_metric "${RESULT_ACCURACY_AVERAGE_SCORE:-}")
  fp4_recovery_display=$(display_optional_metric "${RESULT_FP4_RECOVERY_VS_BF16_PERCENT:-}")
  smoothquant_gain_display=$(display_optional_metric "${RESULT_SMOOTHQUANT_GAIN_VS_NVFP4_PERCENT:-}")
  first_nodeclaim_display=$(display_optional_metric "${RESULT_FIRST_NODECLAIM_SECONDS:-}")
  first_gpu_node_display=$(display_optional_metric "${RESULT_FIRST_GPU_NODE_SECONDS:-}")
  pod_scheduled_display=$(display_optional_metric "${RESULT_POD_SCHEDULED_SECONDS:-}")
  container_started_display=$(display_optional_metric "${RESULT_CONTAINER_STARTED_SECONDS:-}")
  model_ready_display=$(display_optional_metric "${RESULT_MODEL_READY_SECONDS:-}")
  first_successful_completion_display=$(display_optional_metric "${RESULT_FIRST_SUCCESSFUL_COMPLETION_SECONDS:-}")
  cost_scope_display=$(display_optional_metric "${COST_SCOPE:-}")
  cost_instance_type_display=$(display_optional_metric "${COST_INSTANCE_TYPE:-}")
  cost_region_display=$(display_optional_metric "${COST_REGION:-}")
  cost_source_display=$(display_optional_metric "${COST_SOURCE:-}")
  cost_instance_hourly_display=$(display_optional_metric "${COST_INSTANCE_HOURLY_COST_USD:-}")
  cost_accelerator_count_display=$(display_optional_metric "${COST_ACCELERATOR_COUNT:-}")
  cost_accelerator_hourly_display=$(display_optional_metric "${COST_ACCELERATOR_HOURLY_COST_USD:-}")
  cost_linux_hourly_display=$(display_optional_metric "${COST_LINUX_HOURLY_COST_USD:-}")
  serving_hourly_cost_display=$(display_optional_metric "${COST_SERVING_HOURLY_COST_USD:-}")
  estimated_burst_cost_display=$(display_optional_metric "${RESULT_ESTIMATED_BURST_COST_USD:-}")
  estimated_serving_cost_display=$(display_optional_metric "${RESULT_ESTIMATED_SERVING_COST_USD:-}")
  cost_per_1k_display=$(display_optional_metric "${RESULT_COST_PER_1K_SUCCESSFUL_REQUESTS_USD:-${RESULT_COST_PER_1000_SUCCESSFUL_REQUESTS_USD:-}}")
  cost_per_1m_tokens_display=$(display_optional_metric "${RESULT_COST_PER_1M_GENERATED_TOKENS_USD:-}")
  cost_per_accuracy_point_display=$(display_optional_metric "${RESULT_COST_PER_ACCURACY_POINT_USD:-}")
  cost_per_accuracy_recovered_percent_display=$(display_optional_metric "${RESULT_COST_PER_ACCURACY_RECOVERED_PERCENT_USD:-}")
  quantization_build_cost_display=$(display_optional_metric "${RESULT_QUANTIZATION_BUILD_COST_USD:-${COST_QUANTIZATION_BUILD_COST_USD:-}}")
  slo_p95_target_display=$(display_optional_metric "${COST_SLO_P95_REQUEST_LATENCY_SECONDS:-}")
  slo_p99_target_display=$(display_optional_metric "${COST_SLO_P99_REQUEST_LATENCY_SECONDS:-}")
  slo_passed_display=$(display_optional_metric "${RESULT_SLO_PASSED:-}")
  stream_samples_display=$(display_optional_metric "${STREAM_SAMPLES:-}")
  stream_concurrency_display=$(display_optional_metric "${STREAM_CONCURRENCY:-}")
  stream_shape_summary_section=$(render_stream_shape_summary_markdown)

  cat <<EOF
# ${experiment_title_value} - ${CASE_ID}

- Schema version: experiment-report/v1
- Status: ${run_status}
- Generated at: ${generated_at}
- Requires live cluster: true
- Source: ${run_source}

## Workload

| Field | Value |
| --- | --- |
| Experiment | ${experiment_name} |
| Case | ${CASE_ID} |
| Prompt token target | ${PROMPT_TOKEN_TARGET} |
| Max output tokens | ${MAX_TOKENS} |
| Request shapes | ${request_shapes_display_value} |
| Client policy | ${CLIENT_POLICY_ID} |
| Client mode | ${CLIENT_MODE} |
| Load executor | ${CLIENT_EXECUTOR} |
| Buffer capacity | ${CLIENT_BUFFER_CAPACITY_REQUESTS} requests |
| Max queue wait | ${CLIENT_MAX_QUEUE_WAIT_SECONDS}s |
| Start load | ${START_RATE} ${load_unit} |
| Target load | ${TARGET_RATE} ${load_unit} |
| Ramp up | ${RAMP_UP_DURATION} |
| Steady duration | ${STEADY_DURATION} |
| Ramp down | ${RAMP_DOWN_DURATION} |
| Pre-allocated VUs | ${PRE_ALLOCATED_VUS} |
| Max VUs | ${MAX_VUS} |
| Timeout | ${TIMEOUT_SECONDS}s |
| Stream samples | ${stream_samples_display} |
| Stream concurrency | ${stream_concurrency_display} |

## Serving Profile

