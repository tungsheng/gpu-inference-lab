  gpu_memory_free_display=$(display_optional_bytes_gib "${RESULT_GPU_MEMORY_FREE_BYTES:-}")
  kv_cache_source_display=$(display_optional_metric "${RESULT_KV_CACHE_SOURCE:-}")
