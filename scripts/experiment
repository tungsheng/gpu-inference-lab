            name: ${configmap_name}
EOF
}

render_quantization_client_script() {
  cat <<'PY'
import os
from pathlib import Path

from llmcompressor import oneshot

base_model = os.environ["BASE_MODEL"]
output_model = os.environ["OUTPUT_MODEL"]
dataset = os.environ["CALIBRATION_DATASET"]
split = os.environ["CALIBRATION_SPLIT"]
samples = int(os.environ["CALIBRATION_SAMPLES"])
max_seq_len = int(os.environ["CALIBRATION_MAX_SEQ_LEN"])
seed = int(os.environ["CALIBRATION_SEED"])

recipe_globals = {}
exec(Path("/config/recipe.py").read_text(), recipe_globals)
recipe = recipe_globals["recipe"]

oneshot(
    model=base_model,
    dataset=dataset,
    splits=split,
    recipe=recipe,
    output_dir=output_model,
    max_seq_length=max_seq_len,
    num_calibration_samples=samples,
    seed=seed,
)

print("GPU_LAB_QUANTIZATION_SUMMARY_BEGIN")
print(f"base_model={base_model}")
print(f"output_model={output_model}")
print(f"calibration_dataset={dataset}")
print(f"calibration_split={split}")
print(f"calibration_samples={samples}")
print(f"calibration_max_seq_len={max_seq_len}")
print(f"calibration_seed={seed}")
print("GPU_LAB_QUANTIZATION_SUMMARY_END")
PY
}

render_quantization_manifest() {
  local experiment_name=$1
  local profile_id=$2
  local job_name
  local configmap_name
  local recipe_file

  require_experiment "${experiment_name}"
  load_quantization_job "${experiment_name}" "${profile_id}"

  job_name="${experiment_name}-${profile_id}-quantize"
  configmap_name="${job_name}-recipe"
  recipe_file="$(experiment_dir "${experiment_name}")/${QUANTIZATION_RECIPE_PATH}"
  if [[ ! -f "${recipe_file}" ]]; then
    die "Missing quantization recipe: ${recipe_file}"
  fi

  cat <<EOF
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${configmap_name}
  namespace: ${APP_NAMESPACE}
  labels:
    experiment.gpu-lab/name: ${experiment_name}
    experiment.gpu-lab/profile: ${profile_id}
    experiment.gpu-lab/job: quantization
data:
  quantize.py: |
EOF
  render_quantization_client_script | indent_manifest_script
  cat <<EOF
  recipe.py: |
EOF
  indent_manifest_script < "${recipe_file}"
  cat <<EOF
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: ${APP_NAMESPACE}
  labels:
    experiment.gpu-lab/name: ${experiment_name}
    experiment.gpu-lab/profile: ${profile_id}
    experiment.gpu-lab/job: quantization
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        experiment.gpu-lab/name: ${experiment_name}
        experiment.gpu-lab/profile: ${profile_id}
        experiment.gpu-lab/job: quantization
    spec:
      restartPolicy: Never
      nodeSelector:
        workload: gpu
        node.kubernetes.io/instance-type: p6-b200.48xlarge
      tolerations:
        - key: gpu
          operator: Equal
          value: "true"
          effect: NoSchedule
      containers:
        - name: quantize
          image: ${QUANTIZATION_IMAGE}
          args:
            - python
            - /config/quantize.py
          env:
            - name: BASE_MODEL
              value: ${QUANTIZATION_BASE_MODEL}
            - name: OUTPUT_MODEL
              value: ${QUANTIZATION_OUTPUT_MODEL}
            - name: CALIBRATION_DATASET
              value: ${QUANTIZATION_CALIBRATION_DATASET}
            - name: CALIBRATION_SPLIT
              value: ${QUANTIZATION_CALIBRATION_SPLIT}
            - name: CALIBRATION_SAMPLES
              value: "${QUANTIZATION_CALIBRATION_SAMPLES}"
            - name: CALIBRATION_MAX_SEQ_LEN
              value: "${QUANTIZATION_CALIBRATION_MAX_SEQ_LEN}"
            - name: CALIBRATION_SEED
              value: "${QUANTIZATION_CALIBRATION_SEED}"
          resources:
            requests:
              cpu: "64000m"
              memory: 512Gi
              nvidia.com/gpu: "8"
            limits:
              cpu: "96000m"
              memory: 768Gi
              nvidia.com/gpu: "8"
          volumeMounts:
            - name: config
              mountPath: /config
            - name: model-work
              mountPath: /models
            - name: shm
              mountPath: /dev/shm
      volumes:
        - name: config
          configMap:
            name: ${configmap_name}
        - name: model-work
          persistentVolumeClaim:
            claimName: ${MODEL_ARTIFACT_PVC_NAME}
        - name: shm
          emptyDir:
            medium: Memory
            sizeLimit: 64Gi
EOF
}

render_stream_shape_summary_markdown() {
  if [[ -z "${STREAM_SHAPE_SUMMARY_ROWS:-}" ]]; then
    return 0
  fi

  cat <<EOF

## Stream Shape Results

| Shape | Prompt tokens | Max output tokens | Completed | Failed | p95 request latency | p95 TTFT | p95 inter-token latency | Generation tokens/sec |
| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |
${STREAM_SHAPE_SUMMARY_ROWS}
EOF
}

