render_report_json() {
  local experiment_name=$1
  local case_id=$2
  local profile_id=$3
  local generated_at=$4
  local experiment_title_value
  local max_num_seqs_json
  local max_num_batched_tokens_json
  local tensor_parallel_size_json
  local request_shapes_json
  local stream_shape_summaries_json
  local run_status="${RUN_STATUS:-pending}"
  local run_source="${RUN_SOURCE:-scripts/experiment render-report}"

  require_experiment "${experiment_name}"
  load_case "${experiment_name}" "${case_id}"
  load_client_policy "${experiment_name}" "${CASE_ID}"
  load_serving_profile "${experiment_name}" "${profile_id}"
  load_cost_profile "${experiment_name}" "${profile_id}"
  load_cost_detail_profile "${experiment_name}" "${profile_id}"
  load_accuracy_case "${experiment_name}"

  experiment_title_value=$(experiment_title "${experiment_name}")
  max_num_seqs_json=$(json_optional_integer "${MAX_NUM_SEQS}")
  max_num_batched_tokens_json=$(json_optional_integer "${MAX_NUM_BATCHED_TOKENS}")
  tensor_parallel_size_json=$(json_optional_integer "${SERVING_TENSOR_PARALLEL_SIZE}")
  request_shapes_json=$(render_request_shapes_json "${experiment_name}")
  stream_shape_summaries_json=${RESULT_STREAM_SHAPE_SUMMARIES_JSON:-[]}

  cat <<EOF
{
  "schema_version": "experiment-report/v1",
  "experiment": {
    "name": "${experiment_name}",
    "title": "${experiment_title_value}"
  },
  "case": {
    "id": "${CASE_ID}",
    "prompt_token_target": ${PROMPT_TOKEN_TARGET},
    "max_tokens": ${MAX_TOKENS},
    "request_shapes": ${request_shapes_json},
    "client_policy": {
      "id": "${CLIENT_POLICY_ID}",
      "mode": "${CLIENT_MODE}",
      "executor": "${CLIENT_EXECUTOR}",
      "buffer_capacity_requests": ${CLIENT_BUFFER_CAPACITY_REQUESTS},
      "max_queue_wait_seconds": ${CLIENT_MAX_QUEUE_WAIT_SECONDS}
    },
    "arrival": {
      "start_rate": ${START_RATE},
      "target_rate": ${TARGET_RATE},
      "ramp_up_duration": "${RAMP_UP_DURATION}",
      "steady_duration": "${STEADY_DURATION}",
      "ramp_down_duration": "${RAMP_DOWN_DURATION}",
      "pre_allocated_vus": ${PRE_ALLOCATED_VUS},
      "max_vus": ${MAX_VUS},
      "timeout_seconds": ${TIMEOUT_SECONDS}
    },
    "stream": {
      "samples": $(json_optional_integer "${STREAM_SAMPLES:-}"),
      "concurrency": $(json_optional_integer "${STREAM_CONCURRENCY:-}")
    }
  },
  "serving_profile": {
    "id": "${PROFILE_ID}",
    "model": "${MODEL}",
    "served_model_name": "${SERVED_MODEL_NAME}",
    "vllm_image": "${VLLM_IMAGE}",
    "dtype": "${SERVING_DTYPE}",
    "kv_cache_dtype": $(json_optional_string "${KV_CACHE_DTYPE:-}"),
    "calculate_kv_scales": $(json_optional_boolean "${CALCULATE_KV_SCALES:-}"),
    "tensor_parallel_size": ${tensor_parallel_size_json},
    "node_profile": $(json_optional_string "${SERVING_NODE_PROFILE:-}"),
    "max_model_len": ${MAX_MODEL_LEN},
    "gpu_memory_utilization": ${GPU_MEMORY_UTILIZATION},
    "max_num_seqs": ${max_num_seqs_json},
    "max_num_batched_tokens": ${max_num_batched_tokens_json},
    "quantization": {
      "method": $(json_optional_string "${QUANTIZATION_METHOD:-}"),
      "model_artifact_path": $(json_optional_string "${MODEL_ARTIFACT_PATH:-}"),
      "model_artifact_hash": $(json_optional_string "${MODEL_ARTIFACT_HASH:-}"),
      "recipe_hash": $(json_optional_string "${RECIPE_HASH:-}"),
      "calibration": {
        "dataset": $(json_optional_string "${CALIBRATION_DATASET:-}"),
        "split": $(json_optional_string "${CALIBRATION_SPLIT:-}"),
        "samples": $(json_optional_integer "${CALIBRATION_SAMPLES:-}"),
        "max_seq_len": $(json_optional_integer "${CALIBRATION_MAX_SEQ_LEN:-}"),
        "seed": $(json_optional_integer "${CALIBRATION_SEED:-}")
      }
    },
    "accuracy_plan": {
      "case_id": $(json_optional_string "${ACCURACY_CASE_ID:-}"),
      "tasks": $(json_optional_string "${ACCURACY_TASKS:-}"),
      "num_fewshot": $(json_optional_integer "${ACCURACY_NUM_FEWSHOT:-}"),
      "limit": $(json_optional_integer "${ACCURACY_LIMIT:-}"),
      "primary_metric": $(json_optional_string "${ACCURACY_PRIMARY_METRIC:-}")
    },
    "cost_profile": {
      "id": $(json_optional_string "${COST_PROFILE_ID:-}"),
