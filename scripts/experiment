  render_accuracy_client_script "${experiment_name}" "${profile_id}" | indent_manifest_script
  cat <<EOF
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: ${APP_NAMESPACE}
