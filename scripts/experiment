  local shape_prompt_token_target
  local shape_max_tokens
  local shape_weight

  request_shapes_path=$(experiment_request_shapes_path "${experiment_name}")
  if [[ ! -f "${request_shapes_path}" ]]; then
    return 0
  fi

  while IFS=',' read -r row_case_id shape_id shape_prompt_token_target shape_max_tokens shape_weight; do
    if [[ -z "${row_case_id}" || "${row_case_id}" == "case_id" || "${row_case_id}" == \#* ]]; then
      continue
    fi

    load_case "${experiment_name}" "${row_case_id}" >/dev/null
    require_name "${shape_id}" "request shape id"
    require_positive_integer "${shape_prompt_token_target}" "request shape prompt token target"
    require_positive_integer "${shape_max_tokens}" "request shape max tokens"
    require_positive_integer "${shape_weight}" "request shape weight"
  done < "${request_shapes_path}"
}

validate_client_policy_rows() {
  local experiment_name=$1
  local client_policies_path
  local row_case_id
  local row_policy_id
  local row_client_mode
  local row_client_executor
  local row_buffer_capacity
  local row_max_queue_wait
  local _row_description

  client_policies_path=$(experiment_client_policies_path "${experiment_name}")
  if [[ ! -f "${client_policies_path}" ]]; then
    return 0
  fi

  while IFS=',' read -r row_case_id row_policy_id row_client_mode row_client_executor row_buffer_capacity row_max_queue_wait _row_description; do
    if [[ -z "${row_case_id}" || "${row_case_id}" == "case_id" || "${row_case_id}" == \#* ]]; then
      continue
    fi

    load_case "${experiment_name}" "${row_case_id}" >/dev/null
    require_name "${row_policy_id}" "client policy id"
    require_name "${row_client_mode}" "client policy mode"
    case "${row_client_executor}" in
      ramping-arrival-rate|ramping-vus)
        ;;
      *)
        die "Invalid client executor: ${row_client_executor}"
        ;;
    esac
    require_non_negative_integer "${row_buffer_capacity}" "client buffer capacity"
    require_non_negative_integer "${row_max_queue_wait}" "client max queue wait seconds"
  done < "${client_policies_path}"
}

validate_cost_profile_rows() {
  local experiment_name=$1
  local cost_profiles_path
  local row_profile_id
  local row_hourly_cost
  local row_scope
  local row_p95_slo
  local row_p99_slo
  local _row_description

  cost_profiles_path=$(experiment_cost_profiles_path "${experiment_name}")
  if [[ ! -f "${cost_profiles_path}" ]]; then
    return 0
  fi

  while IFS=',' read -r row_profile_id row_hourly_cost row_scope row_p95_slo row_p99_slo _row_description; do
    if [[ -z "${row_profile_id}" || "${row_profile_id}" == "profile_id" || "${row_profile_id}" == \#* ]]; then
      continue
    fi

    load_serving_profile "${experiment_name}" "${row_profile_id}" >/dev/null
    require_rate "${row_hourly_cost}" "serving hourly cost"
    require_safe_text "${row_scope}" "cost scope"
    if [[ -n "${row_p95_slo}" ]]; then
      require_rate "${row_p95_slo}" "p95 request latency SLO"
    fi
    if [[ -n "${row_p99_slo}" ]]; then
      require_rate "${row_p99_slo}" "p99 request latency SLO"
    fi
  done < "${cost_profiles_path}"
}

validate_cost_detail_rows() {
  local experiment_name=$1
  local cost_details_path
  local row_profile_id
  local _row_rest

  cost_details_path=$(experiment_cost_details_path "${experiment_name}")
  if [[ ! -f "${cost_details_path}" ]]; then
    return 0
  fi

  while IFS=',' read -r row_profile_id _row_rest; do
    if [[ -z "${row_profile_id}" || "${row_profile_id}" == "profile_id" || "${row_profile_id}" == \#* ]]; then
      continue
    fi

    load_serving_profile "${experiment_name}" "${row_profile_id}" >/dev/null
    load_cost_detail_profile "${experiment_name}" "${row_profile_id}"
  done < "${cost_details_path}"
}

validate_serving_extension_rows() {
  local experiment_name=$1
  local extensions_path
  local row_profile_id
  local _row_rest

  extensions_path=$(experiment_serving_extensions_path "${experiment_name}")
  if [[ ! -f "${extensions_path}" ]]; then
    return 0
  fi

  while IFS=',' read -r row_profile_id _row_rest; do
    if [[ -z "${row_profile_id}" || "${row_profile_id}" == "profile_id" || "${row_profile_id}" == \#* ]]; then
      continue
    fi

    load_serving_profile "${experiment_name}" "${row_profile_id}" >/dev/null
    load_serving_extension "${experiment_name}" "${row_profile_id}"
  done < "${extensions_path}"
}

validate_accuracy_case_rows() {
  local experiment_name=$1
  local accuracy_cases_path
  local row_case_id
  local _row_rest

  accuracy_cases_path=$(experiment_accuracy_cases_path "${experiment_name}")
  if [[ ! -f "${accuracy_cases_path}" ]]; then
    return 0
  fi

  while IFS=',' read -r row_case_id _row_rest; do
    if [[ -z "${row_case_id}" || "${row_case_id}" == "case_id" || "${row_case_id}" == \#* ]]; then
      continue
    fi

    load_accuracy_case "${experiment_name}" "${row_case_id}"
  done < "${accuracy_cases_path}"
}

validate_quantization_job_rows() {
  local experiment_name=$1
  local jobs_path
  local row_profile_id
  local _row_rest
  local recipe_file

  jobs_path=$(experiment_quantization_jobs_path "${experiment_name}")
  if [[ ! -f "${jobs_path}" ]]; then
    return 0
  fi

  while IFS=',' read -r row_profile_id _row_rest; do
    if [[ -z "${row_profile_id}" || "${row_profile_id}" == "profile_id" || "${row_profile_id}" == \#* ]]; then
      continue
    fi

    load_quantization_job "${experiment_name}" "${row_profile_id}"
    recipe_file="$(experiment_dir "${experiment_name}")/${QUANTIZATION_RECIPE_PATH}"
    if [[ ! -f "${recipe_file}" ]]; then
      die "Missing quantization recipe: ${recipe_file}"
    fi
  done < "${jobs_path}"
}

validate_experiment() {
  local experiment_name=$1
  local cases_path
  local serving_profiles_path
  local request_shapes_path
  local client_policies_path
  local cost_profiles_path
  local cost_details_path
  local serving_extensions_path
  local accuracy_cases_path
  local quantization_jobs_path

  require_experiment "${experiment_name}"
  require_serving_profiles "${experiment_name}"

  cases_path=$(experiment_cases_path "${experiment_name}")
  serving_profiles_path=$(experiment_serving_profiles_path "${experiment_name}")
  request_shapes_path=$(experiment_request_shapes_path "${experiment_name}")
  client_policies_path=$(experiment_client_policies_path "${experiment_name}")
  cost_profiles_path=$(experiment_cost_profiles_path "${experiment_name}")
  cost_details_path=$(experiment_cost_details_path "${experiment_name}")
  serving_extensions_path=$(experiment_serving_extensions_path "${experiment_name}")
  accuracy_cases_path=$(experiment_accuracy_cases_path "${experiment_name}")
  quantization_jobs_path=$(experiment_quantization_jobs_path "${experiment_name}")

  validate_csv_field_count "${cases_path}" 12
  validate_csv_field_count "${serving_profiles_path}" 15
  if [[ -f "${request_shapes_path}" ]]; then
    validate_csv_field_count "${request_shapes_path}" 5
  fi
  if [[ -f "${client_policies_path}" ]]; then
    validate_csv_field_count "${client_policies_path}" 7
  fi
  if [[ -f "${cost_profiles_path}" ]]; then
    validate_csv_field_count "${cost_profiles_path}" 6
  fi
  if [[ -f "${cost_details_path}" ]]; then
    validate_csv_field_count "${cost_details_path}" 11
  fi
  if [[ -f "${serving_extensions_path}" ]]; then
    validate_csv_field_count "${serving_extensions_path}" 16
  fi
  if [[ -f "${accuracy_cases_path}" ]]; then
    validate_csv_field_count "${accuracy_cases_path}" 6
  fi
  if [[ -f "${quantization_jobs_path}" ]]; then
    validate_csv_field_count "${quantization_jobs_path}" 11
  fi

  validate_case_rows "${experiment_name}"
  validate_serving_profile_rows "${experiment_name}"
  validate_request_shape_rows "${experiment_name}"
  validate_client_policy_rows "${experiment_name}"
  validate_cost_profile_rows "${experiment_name}"
  validate_cost_detail_rows "${experiment_name}"
  validate_serving_extension_rows "${experiment_name}"
  validate_accuracy_case_rows "${experiment_name}"
  validate_quantization_job_rows "${experiment_name}"
}

check_reports_against_schema() {
  if [[ ! -f "${REPORT_SCHEMA_PATH}" ]]; then
    die "Missing report schema: ${REPORT_SCHEMA_PATH}"
  fi

  if [[ ! -f "${REPORT_SCHEMA_VALIDATOR}" ]]; then
    die "Missing report schema validator: ${REPORT_SCHEMA_VALIDATOR}"
  fi

  require_commands python3

  python3 "${REPORT_SCHEMA_VALIDATOR}" --schema "${REPORT_SCHEMA_PATH}" "$@"
}

validate_evidence_reports() {
  local reports=()
  local report_path

  while IFS= read -r report_path; do
    reports+=("${report_path}")
  done < <(find "${EXPERIMENTS_DIR}" -mindepth 3 -maxdepth 3 -type f -path '*/evidence/*.json' | sort)

  if ((${#reports[@]} == 0)); then
    printf 'Validated 0 evidence report(s).\n'
    return 0
  fi

  if ! check_reports_against_schema "${reports[@]}"; then
    die "Curated evidence does not match ${REPORT_SCHEMA_PATH##*/}"
  fi

  printf 'Validated %s evidence report(s) against %s.\n' "${#reports[@]}" "${REPORT_SCHEMA_PATH##*/}"
}

validate_experiment_catalog() {
  local experiment_path
  local experiment_name
  local validated_count=0

  validate_csv_field_count "${SERVING_DEFAULTS_PATH}" 15
  load_default_serving_profile
  require_template "${LOAD_CLIENT_TEMPLATE}"
  require_template "${STREAM_CLIENT_TEMPLATE}"
  require_template "${ACCURACY_CLIENT_TEMPLATE}"

  # Underscore-prefixed directories are reserved for shared catalog assets
  # (_profiles, _schemas, _templates), not experiments.
  while read -r experiment_path; do
    experiment_name=$(basename "${experiment_path}")
    validate_experiment "${experiment_name}"
    validated_count=$((validated_count + 1))
  done < <(find "${EXPERIMENTS_DIR}" -mindepth 1 -maxdepth 1 -type d ! -name '_*' | sort)

  printf 'Validated %s experiment(s).\n' "${validated_count}"
  validate_evidence_reports
}

render_arrival_rate_scenario_values() {
  local start_rate=$1
  local target_rate=$2

  awk -v start_rate="${start_rate}" -v target_rate="${target_rate}" '
    function abs(value) {
      return value < 0 ? -value : value
    }

    BEGIN {
      for (unit = 1; unit <= 600; unit++) {
        start = start_rate * unit
        target = target_rate * unit
        rendered_start = int(start + 0.5)
        rendered_target = int(target + 0.5)

        if (abs(start - rendered_start) < 0.000001 && abs(target - rendered_target) < 0.000001) {
          printf "%s %s %s\n", rendered_start, rendered_target, unit
          exit 0
        }
      }

      exit 1
    }
  ' || die "Could not render k6 arrival-rate scenario for start_rate=${start_rate} target_rate=${target_rate}"
}

render_k6_scenario() {
  local rendered_start_rate
  local rendered_target_rate
  local rendered_time_unit_seconds

  case "${CLIENT_EXECUTOR}" in
    ramping-arrival-rate)
      read -r rendered_start_rate rendered_target_rate rendered_time_unit_seconds < <(
        render_arrival_rate_scenario_values "${START_RATE}" "${TARGET_RATE}"
      )
      cat <<EOF
        inference_burst: {
          executor: "ramping-arrival-rate",
          startRate: ${rendered_start_rate},
          timeUnit: "${rendered_time_unit_seconds}s",
          preAllocatedVUs: ${PRE_ALLOCATED_VUS},
          maxVUs: ${MAX_VUS},
          stages: [
            { duration: "${RAMP_UP_DURATION}", target: ${rendered_target_rate} },
            { duration: "${STEADY_DURATION}", target: ${rendered_target_rate} },
            { duration: "${RAMP_DOWN_DURATION}", target: 0 },
          ],
        },
EOF
      ;;
    ramping-vus)
      require_non_negative_integer "${START_RATE}" "ramping-vus start VUs"
      require_non_negative_integer "${TARGET_RATE}" "ramping-vus target VUs"
      cat <<EOF
        inference_burst: {
          executor: "ramping-vus",
          startVUs: ${START_RATE},
          stages: [
            { duration: "${RAMP_UP_DURATION}", target: ${TARGET_RATE} },
            { duration: "${STEADY_DURATION}", target: ${TARGET_RATE} },
            { duration: "${RAMP_DOWN_DURATION}", target: 0 },
          ],
        },
EOF
      ;;
    *)
      die "Invalid client executor: ${CLIENT_EXECUTOR}"
      ;;
  esac
}

render_optional_vllm_scheduler_args() {
  if [[ -n "${MAX_NUM_SEQS}" ]]; then
    cat <<EOF
            - --max-num-seqs
            - "${MAX_NUM_SEQS}"
EOF
  fi

  if [[ -n "${MAX_NUM_BATCHED_TOKENS}" ]]; then
    cat <<EOF
            - --max-num-batched-tokens
            - "${MAX_NUM_BATCHED_TOKENS}"
EOF
  fi
}

render_optional_vllm_parallel_args() {
  if [[ -n "${SERVING_TENSOR_PARALLEL_SIZE}" ]]; then
    cat <<EOF
            - --tensor-parallel-size
            - "${SERVING_TENSOR_PARALLEL_SIZE}"
EOF
  fi
}

render_optional_vllm_kv_cache_args() {
  if [[ -n "${KV_CACHE_DTYPE}" ]]; then
    cat <<EOF
            - --kv-cache-dtype
            - ${KV_CACHE_DTYPE}
EOF
  fi

  if [[ "${CALCULATE_KV_SCALES}" == "true" ]]; then
    cat <<EOF
            - --calculate-kv-scales
EOF
  fi
}

render_optional_vllm_prefix_cache_args() {
  case "${PROFILE_ID}" in
    *prefix*)
      cat <<EOF
            - --enable-prefix-caching
EOF
      ;;
  esac
}

render_optional_vllm_observability_args() {
  local experiment_name=$1

  if [[ "${experiment_name}" == "kv-cache-observatory" ]]; then
    cat <<EOF
            - --kv-cache-metrics
            - --kv-cache-metrics-sample
            - "1.0"
EOF
  fi
}

render_optional_node_selector_labels() {
  case "${SERVING_NODE_PROFILE}" in
    blackwell)
      cat <<EOF
        node.kubernetes.io/instance-type: p6-b200.48xlarge
EOF
      ;;
    "")
      ;;
    *)
      cat <<EOF
        gpu-lab/node-profile: ${SERVING_NODE_PROFILE}
EOF
      ;;
  esac
}

serving_uses_model_artifacts_volume() {
  [[ "${MODEL}" == /models/* ]]
}

render_optional_model_artifact_volume_mounts() {
  if serving_uses_model_artifacts_volume; then
    cat <<EOF
            - name: model-artifacts
              mountPath: /models
EOF
  fi
}

render_optional_model_artifact_volumes() {
  if serving_uses_model_artifacts_volume; then
    cat <<EOF
        - name: model-artifacts
          persistentVolumeClaim:
            claimName: ${MODEL_ARTIFACT_PVC_NAME}
EOF
  fi
}

require_template() {
  local template_path=$1

  if [[ ! -f "${template_path}" ]]; then
    die "Missing render template: ${template_path}"
  fi
}

indent_manifest_script() {
  sed 's/^/    /'
}

render_load_client_script() {
  local experiment_name=$1
  local served_model_name=$2
  local request_shapes_js=$3
  local target_url="http://${GPU_INFERENCE_SERVICE_NAME}.${APP_NAMESPACE}.svc.cluster.local/v1/completions"
  local scenario
  local rendered

  require_template "${LOAD_CLIENT_TEMPLATE}"
  scenario=$(render_k6_scenario)
  rendered=$(<"${LOAD_CLIENT_TEMPLATE}")
  rendered=${rendered//@EXPERIMENT_NAME@/${experiment_name}}
  rendered=${rendered//@CASE_ID@/${CASE_ID}}
  rendered=${rendered//@PROMPT_TOKEN_TARGET@/${PROMPT_TOKEN_TARGET}}
  rendered=${rendered//@MAX_TOKENS@/${MAX_TOKENS}}
  rendered=${rendered//@TIMEOUT_SECONDS@/${TIMEOUT_SECONDS}}
  rendered=${rendered//@CLIENT_POLICY_ID@/${CLIENT_POLICY_ID}}
  rendered=${rendered//@CLIENT_MODE@/${CLIENT_MODE}}
  rendered=${rendered//@CLIENT_BUFFER_CAPACITY_REQUESTS@/${CLIENT_BUFFER_CAPACITY_REQUESTS}}
  rendered=${rendered//@CLIENT_MAX_QUEUE_WAIT_SECONDS@/${CLIENT_MAX_QUEUE_WAIT_SECONDS}}
  rendered=${rendered//@REQUEST_SHAPES_JS@/${request_shapes_js}}
  rendered=${rendered//@K6_SCENARIO@/${scenario}}
  rendered=${rendered//@TARGET_URL@/${target_url}}
  rendered=${rendered//@MODEL_NAME@/${served_model_name}}
  printf '%s\n' "${rendered}"
}

render_stream_client_script() {
  local experiment_name=$1
  local served_model_name=$2
  local samples=$3
  local stream_concurrency=$4
  local request_shapes_json=$5
  local target_url="http://${GPU_INFERENCE_SERVICE_NAME}.${APP_NAMESPACE}.svc.cluster.local/v1/completions"
  local rendered

  require_template "${STREAM_CLIENT_TEMPLATE}"
  rendered=$(<"${STREAM_CLIENT_TEMPLATE}")
  rendered=${rendered//@EXPERIMENT_NAME@/${experiment_name}}
  rendered=${rendered//@CASE_ID@/${CASE_ID}}
  rendered=${rendered//@PROMPT_TOKEN_TARGET@/${PROMPT_TOKEN_TARGET}}
  rendered=${rendered//@MAX_TOKENS@/${MAX_TOKENS}}
  rendered=${rendered//@REQUEST_SHAPES_JSON@/${request_shapes_json}}
  rendered=${rendered//@SAMPLES@/${samples}}
  rendered=${rendered//@STREAM_CONCURRENCY@/${stream_concurrency}}
  rendered=${rendered//@TIMEOUT_SECONDS@/${TIMEOUT_SECONDS}}
  rendered=${rendered//@TARGET_URL@/${target_url}}
  rendered=${rendered//@MODEL_NAME@/${served_model_name}}
  printf '%s\n' "${rendered}"
}

render_accuracy_client_script() {
  local experiment_name=$1
  local profile_id=$2
  local accuracy_tasks_csv
  local target_url="http://${GPU_INFERENCE_SERVICE_NAME}.${APP_NAMESPACE}.svc.cluster.local/v1/completions"
  local rendered

  require_template "${ACCURACY_CLIENT_TEMPLATE}"
  accuracy_tasks_csv=$(tasks_pipe_to_csv "${ACCURACY_TASKS}")
  rendered=$(<"${ACCURACY_CLIENT_TEMPLATE}")
  rendered=${rendered//@EXPERIMENT_NAME@/${experiment_name}}
  rendered=${rendered//@PROFILE_ID@/${profile_id}}
  rendered=${rendered//@ACCURACY_CASE_ID@/${ACCURACY_CASE_ID}}
  rendered=${rendered//@ACCURACY_TASKS_CSV@/${accuracy_tasks_csv}}
  rendered=${rendered//@ACCURACY_NUM_FEWSHOT@/${ACCURACY_NUM_FEWSHOT}}
  rendered=${rendered//@ACCURACY_LIMIT@/${ACCURACY_LIMIT}}
  rendered=${rendered//@ACCURACY_PRIMARY_METRIC@/${ACCURACY_PRIMARY_METRIC}}
  rendered=${rendered//@TARGET_URL@/${target_url}}
  rendered=${rendered//@MODEL_NAME@/${SERVED_MODEL_NAME}}
  printf '%s\n' "${rendered}"
}

render_serving_manifest() {
  local experiment_name=$1
  local profile_id=$2
  local serving_gpu_count="1"

  load_serving_profile "${experiment_name}" "${profile_id}"
  if [[ -n "${SERVING_TENSOR_PARALLEL_SIZE}" ]]; then
    serving_gpu_count=${SERVING_TENSOR_PARALLEL_SIZE}
  fi

  cat <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vllm-openai
  namespace: app
spec:
  replicas: 1
  selector:
    matchLabels:
      app: vllm-openai
  template:
    metadata:
      labels:
        app: vllm-openai
    spec:
      terminationGracePeriodSeconds: 120
      nodeSelector:
        workload: gpu
EOF
  render_optional_node_selector_labels
  cat <<EOF
      tolerations:
        - key: gpu
          operator: Equal
          value: "true"
          effect: NoSchedule
      containers:
        - name: server
          image: ${VLLM_IMAGE}
          args:
            - --model
            - ${MODEL}
            - --served-model-name
            - ${SERVED_MODEL_NAME}
            - --host
            - 0.0.0.0
            - --port
            - "8000"
            - --dtype
            - ${SERVING_DTYPE}
            - --max-model-len
            - "${MAX_MODEL_LEN}"
            - --gpu-memory-utilization
            - "${GPU_MEMORY_UTILIZATION}"
EOF
  render_optional_vllm_parallel_args
  render_optional_vllm_scheduler_args
  render_optional_vllm_kv_cache_args
  render_optional_vllm_prefix_cache_args
  render_optional_vllm_observability_args "${experiment_name}"
  cat <<EOF
          env:
            - name: HF_HOME
              value: /cache/huggingface
            - name: HF_HUB_DISABLE_TELEMETRY
              value: "1"
          ports:
            - containerPort: 8000
              name: http
          # The startup probe owns the cold-start budget (620s) so image pull
          # and model load cannot trip the liveness probe and crash-loop the
          # pod. Readiness and liveness only begin once startup succeeds.
          startupProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 20
            periodSeconds: 10
            failureThreshold: 60
          readinessProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 10
            failureThreshold: 60
          livenessProbe:
            httpGet:
              path: /health
              port: http
            periodSeconds: 20
            failureThreshold: 6
          resources:
            requests:
              cpu: "${CPU_REQUEST}"
              memory: ${MEMORY_REQUEST}
              nvidia.com/gpu: "${serving_gpu_count}"
            limits:
              cpu: "${CPU_LIMIT}"
              memory: ${MEMORY_LIMIT}
              nvidia.com/gpu: "${serving_gpu_count}"
          volumeMounts:
            - name: model-cache
              mountPath: /cache/huggingface
EOF
  render_optional_model_artifact_volume_mounts
  cat <<EOF
            - name: shm
              mountPath: /dev/shm
      volumes:
        - name: model-cache
          emptyDir:
            sizeLimit: ${MODEL_CACHE_SIZE}
EOF
  render_optional_model_artifact_volumes
  cat <<EOF
        - name: shm
          emptyDir:
            medium: Memory
            sizeLimit: ${SHM_SIZE}
EOF
}

render_load_manifest() {
  local experiment_name=$1
  local case_id=$2
  local job_name
  local configmap_name
  local load_served_model_name
  local request_shapes_js

  require_experiment "${experiment_name}"
  load_case "${experiment_name}" "${case_id}"
  load_client_policy "${experiment_name}" "${CASE_ID}"

  job_name="${experiment_name}-${CASE_ID}"
  configmap_name="${job_name}-load"
  load_served_model_name="${SERVED_MODEL_NAME:-${GPU_INFERENCE_SERVED_MODEL_NAME}}"
  request_shapes_js=$(render_request_shapes_js "${experiment_name}")

  cat <<EOF
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${configmap_name}
  namespace: ${APP_NAMESPACE}
  labels:
    experiment.gpu-lab/name: ${experiment_name}
    experiment.gpu-lab/case: ${CASE_ID}
data:
  load-test.js: |
EOF
  render_load_client_script "${experiment_name}" "${load_served_model_name}" "${request_shapes_js}" | indent_manifest_script
  cat <<EOF
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: ${APP_NAMESPACE}
  labels:
    experiment.gpu-lab/name: ${experiment_name}
    experiment.gpu-lab/case: ${CASE_ID}
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        experiment.gpu-lab/name: ${experiment_name}
        experiment.gpu-lab/case: ${CASE_ID}
    spec:
      restartPolicy: Never
      containers:
        - name: k6
          image: grafana/k6:0.49.0
          args:
            - run
            - /scripts/load-test.js
          env:
            - name: TARGET_URL
              value: http://${GPU_INFERENCE_SERVICE_NAME}.${APP_NAMESPACE}.svc.cluster.local/v1/completions
            - name: MODEL_NAME
              value: ${load_served_model_name}
          volumeMounts:
            - name: scripts
              mountPath: /scripts
      volumes:
        - name: scripts
          configMap:
            name: ${configmap_name}
EOF
}

render_stream_manifest() {
  local experiment_name=$1
  local case_id=$2
  local samples=$3
  local stream_concurrency=$4
  local job_name
  local configmap_name
  local stream_served_model_name
  local request_shapes_json

  require_experiment "${experiment_name}"
  load_case "${experiment_name}" "${case_id}"
  require_positive_integer "${samples}" "stream samples"
  require_positive_integer "${stream_concurrency}" "stream concurrency"

  job_name=$(stream_job_name "${experiment_name}" "${CASE_ID}")
  configmap_name="${job_name}-client"
  stream_served_model_name="${SERVED_MODEL_NAME:-${GPU_INFERENCE_SERVED_MODEL_NAME}}"
  request_shapes_json=$(render_request_shapes_json "${experiment_name}")

  cat <<EOF
apiVersion: v1
kind: ConfigMap
metadata:
  name: ${configmap_name}
  namespace: ${APP_NAMESPACE}
  labels:
    experiment.gpu-lab/name: ${experiment_name}
    experiment.gpu-lab/case: ${CASE_ID}
    experiment.gpu-lab/client: stream
data:
  stream-client.py: |
EOF
  render_stream_client_script "${experiment_name}" "${stream_served_model_name}" "${samples}" "${stream_concurrency}" "${request_shapes_json}" | indent_manifest_script
  cat <<EOF
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: ${APP_NAMESPACE}
  labels:
    experiment.gpu-lab/name: ${experiment_name}
    experiment.gpu-lab/case: ${CASE_ID}
    experiment.gpu-lab/client: stream
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        experiment.gpu-lab/name: ${experiment_name}
        experiment.gpu-lab/case: ${CASE_ID}
        experiment.gpu-lab/client: stream
    spec:
      restartPolicy: Never
      containers:
        - name: stream-client
          image: python:3.12-slim
          args:
            - python
            - /scripts/stream-client.py
          volumeMounts:
            - name: scripts
              mountPath: /scripts
      volumes:
        - name: scripts
          configMap:
            name: ${configmap_name}
EOF
}

